                                       $"G1 Z0. F0.1\n" +
                                       $"X{CalculatedNptStart.NC()} C{(ThreadChamfer + InsertRadius / 2).NC()}\n" +
                                       $"G1 Z{EndPointZ.NC()} A1.79";
                            }
                        default:
