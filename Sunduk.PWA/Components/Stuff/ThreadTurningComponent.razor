    private void OnStandardChanged(ThreadStandard value)
    {
        if (ThreadStandard == value) return;
        ThreadStandard = value;
        ThreadPitchString = string.Empty;
        ThreadDiameterString = string.Empty;
        CurrentThreadTemplate = string.Empty;
    }

    private void OnTemplateChanged(string value)
    {
        CurrentThreadTemplate = value;
        switch (ThreadStandard)
        {
            case ThreadStandard.Metric:
                Thread.GetMetricValues(CurrentThreadTemplate, out string mDiameter, out string mPitch);
                ThreadDiameterString = mDiameter;
                ThreadPitchString = mPitch;
                PlaneLength = 0;
                EndPointZ = -20 - Math.Round(Thread.ThreadRunout(ThreadStandard, ThreadPitch, ThreadType), 1);
                ThreadChamfer = Thread.ThreadChamfer(ThreadStandard, ThreadPitch, ThreadType);
                break;

            case ThreadStandard.BSPP:
                Thread.GetBsppValues(CurrentThreadTemplate, out string bDiameter, out string bPitch);
                ThreadDiameterString = bDiameter;
                ThreadPitchString = bPitch;
                PlaneLength = 0;
                EndPointZ = -20 - Math.Round(Thread.ThreadRunout(ThreadStandard, ThreadPitch, ThreadType), 1);
                ThreadChamfer = Thread.ThreadChamfer(ThreadStandard, ThreadPitch, ThreadType);
                break;

            case ThreadStandard.Trapezoidal:
                Thread.GetTrapezoidalValues(CurrentThreadTemplate, out string tDiameter, out string tPitch);
                ThreadDiameterString = tDiameter;
                ThreadPitchString = tPitch;
                PlaneLength = 0;
                EndPointZ = -30;
                ThreadChamfer = Thread.ThreadChamfer(ThreadStandard, ThreadPitch, ThreadType);
                break;

            case ThreadStandard.NPT:
                Thread.GetNptValues(CurrentThreadTemplate, out string nExtDiam, out string nIntDiam, out string nPitch, out double nPlane, out double nLength);
                ThreadDiameterString = nExtDiam;
                ThreadPitchString = nPitch;
                PlaneLength = nPlane;
                EndPointZ = -nLength - Math.Round(Thread.ThreadRunout(ThreadStandard, ThreadPitch, ThreadType), 1);
                ThreadChamfer = Thread.ThreadChamfer(ThreadStandard, ThreadPitch, ThreadType);
                break;

            case ThreadStandard.BSPT:
                Thread.GetBsptValues(CurrentThreadTemplate, out string pExtDiam, out string pIntDiam, out string pPitch, out double pPlane, out double pLength);
                ThreadDiameterString = pExtDiam;
                ThreadPitchString = pPitch;
                PlaneLength = pPlane;
                EndPointZ = -pLength - Math.Round(Thread.ThreadRunout(ThreadStandard, ThreadPitch, ThreadType), 1);
                ThreadChamfer = Thread.ThreadChamfer(ThreadStandard, ThreadPitch, ThreadType);
                break;

            case ThreadStandard.UNC:
                Thread.GetUncValues(CurrentThreadTemplate, out string ucDiam, out string ucPitch);
                ThreadDiameterString = ucDiam;
                ThreadPitchString = ucPitch;
                PlaneLength = 0;
                EndPointZ = -20 - Math.Round(Thread.ThreadRunout(ThreadStandard, ThreadPitch, ThreadType), 1);
                ThreadChamfer = Thread.ThreadChamfer(ThreadStandard, ThreadPitch, ThreadType);
                break;

            case ThreadStandard.UNF:
                Thread.GetUnfValues(CurrentThreadTemplate, out string ufDiam, out string ufPitch);
                ThreadDiameterString = ufDiam;
                ThreadPitchString = ufPitch;
                PlaneLength = 0;
                EndPointZ = -20 - Math.Round(Thread.ThreadRunout(ThreadStandard, ThreadPitch, ThreadType), 1);
                ThreadChamfer = Thread.ThreadChamfer(ThreadStandard, ThreadPitch, ThreadType);
                break;

            case ThreadStandard.UNEF:
                Thread.GetUnefValues(CurrentThreadTemplate, out string uefDiam, out string uefPitch);
                ThreadDiameterString = uefDiam;
                ThreadPitchString = uefPitch;
                PlaneLength = 0;
                EndPointZ = -20 - Math.Round(Thread.ThreadRunout(ThreadStandard, ThreadPitch, ThreadType), 1);
                ThreadChamfer = Thread.ThreadChamfer(ThreadStandard, ThreadPitch, ThreadType);
                break;
        }
    }

    public double? MediumX
    {
        get
        {
            double? minX = Contour.Select(x => x.X).Min();
            if (minX > 0) minX = 0;
            double? maxX = Contour.Select(x => x.X).Max();
            return (maxX + minX) / 2;
        }
    }

    public double? MaxLength
    {
        get
        {
            double? minZ = Contour.Select(x => x.Z).Min();
            double? maxZ = Contour.Select(x => x.Z).Max();
            return maxZ - minZ;
        }
    }

    public double? MediumZ
    {
        get
        {
            double? minZ = Contour.Select(x => x.Z).Min();
            double? maxZ = Contour.Select(x => x.Z).Max();
            return (maxZ + minZ) / 2;
        }
    }

    public double ContourHeight
    {
        get
        {
            double maxHeight = 200;
            double tempCalc = 21.84 * 2 + 20;
            if (tempCalc > maxHeight) maxHeight = tempCalc;
            return Math.Abs(maxHeight);
        }
    }

    public double ContourWidth
    {
        get
        {
            double maxWidth = 400;
            double tempCalc = (MaxLength ?? 0) * 6;
            if (tempCalc > maxWidth) maxWidth = tempCalc;
            return Math.Abs(maxWidth);
        }
    }

    public string Path
    {
        get
        {
            if (Contour.Count < 1) return string.Empty;
            if (Contour[0].X is null && Contour[0].Z is null) return string.Empty;
            string path = string.Empty;
            foreach (var element in Contour)
            {
                switch (element)
                {
                    case Point point:
                        path += $"M {(point.Z * 4)?.ToString().Replace(",", ".")},{(-point.X / 2 * 4)?.ToString().Replace(",", ".")} ";
                        if (point.Blunt > 0 && Contour.Count > Contour.IndexOf(point) + 1)
                        {
                            path += $"A{(point.Blunt * 4).ToString(CultureInfo.InvariantCulture)},{(point.Blunt * 4).ToString(CultureInfo.InvariantCulture)},0,0{(point.Z > (Contour[Contour.IndexOf(point) + 1].Z) ? 0 : 1)},{(point.Z > (Contour[Contour.IndexOf(point) + 1].Z) ? -point.Blunt * 4 : point.Blunt * 4).ToString(CultureInfo.InvariantCulture)},{(-Contour[Contour.IndexOf(point) + 1].X / 2 * 4)?.ToString().Replace(",", ".")} ";
                        }
                        break;
                    case Line line:
                        double? tempLineX = line.X ?? Contour[Contour.IndexOf(line) - 1].X;
                        double? tempLineZ = line.Z ?? Contour[Contour.IndexOf(line) - 1].Z;
                        path += $"L {(tempLineZ * 4)?.ToString().Replace(",", ".")},{(-tempLineX / 2 * 4)?.ToString().Replace(",", ".")} ";
                        break;
                    case Arc arc:
                        double? tempArcX = arc.X ?? Contour[Contour.IndexOf(arc) - 1].X;
                        double? tempArcZ = arc.Z ?? Contour[Contour.IndexOf(arc) - 1].Z;
                        if (ValidArc(Contour.IndexOf(arc)))
                        {
                            path += $"A{(arc.Radius * 4).ToString(CultureInfo.InvariantCulture)},{(arc.Radius * 4).ToString(CultureInfo.InvariantCulture)},0,0{(arc.Direction is Sunduk.Geometry.Direction.CCW ? 0 : 1)},{(tempArcZ * 4)?.ToString().Replace(",", ".")},{(-tempArcX / 2 * 4)?.ToString().Replace(",", ".")} ";
                        }
                        else
                        {
                            path += $"L {(tempArcZ * 4)?.ToString().Replace(",", ".")},{(-tempArcX / 2 * 4)?.ToString().Replace(",", ".")} ";
                        }
                        break;
                }
            }
            return path;
        }
        set { }
    }

    bool ValidArc(int index)
    {
        if (index >= Contour.Count || index <= 0) return false;
        double radius = ((Contour[index] as Arc)!).Radius;
        if (radius <= 0) return false;
        double? xDifference = (Contour[index].X - Contour[index - 1].X) / 2;
        double? zDifference = Contour[index].Z - Contour[index - 1].Z;
        double length = Math.Sqrt(Math.Pow(xDifference ?? 0, 2) + Math.Pow(zDifference ?? 0, 2));
        return !(radius * 2 < length);
    }

    public List<Element> Contour => new()
    {
        new Point(ThreadType == CuttingType.External ? CalculatedNptChamferStartX + InsertRadius : CalculatedNptChamferStartX - InsertRadius, 0),
        new Line(CalculatedNptChamferEndX, ThreadChamfer),
        new Line(ThreadType == CuttingType.External
            ? CalculatedNptStart + 2 * Math.Tan(1.79.Radians()) * Math.Abs(EndPointZ)
            : CalculatedNptStart - 2 * Math.Tan(1.79.Radians()) * Math.Abs(EndPointZ),
            EndPointZ),
    };
