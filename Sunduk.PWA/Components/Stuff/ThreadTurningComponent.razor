                        default:
                            return string.Empty;
                    }

                case ThreadStandard.BSPP:
                    switch (ThreadType)
                    {
                        case CuttingType.External:
                            if (Blunted)
                            {
                                var chamferStartX = ThreadDiameter - 2 * ThreadChamfer - InsertRadius;
                                return $"G0 X{(chamferStartX - 2 * GeometryMath.ChamferRadiusLengths(45, InsertRadius + BluntSize).X).NC()} Z1. S180 M3\n" +
                                       $"G1 Z0. F0.1\n" +
                                       $"X{chamferStartX.NC()} R{(InsertRadius + BluntSize).NC()}\n" +
                                       $"X{ThreadDiameter.NC()} A-45. R{(InsertRadius + BluntSize).NC()}\n" +
                                       $"G1 Z{EndPointZ.NC()}";
                            }
                            else
                            {
                                return $"G0 X{(ThreadDiameter - 2 * ThreadChamfer - InsertRadius).NC()} Z1. S180 M3\n" +
                                       $"G1 Z0. F0.1\n" +
                                       $"X{ThreadDiameter.NC()} C{(ThreadChamfer + InsertRadius / 2).NC()}\n" +
                                       $"G1 Z{EndPointZ.NC()}";
                            }
                        case CuttingType.Internal:
                            var intChamferStartX = Thread.BsppHoleDiameter(CurrentThreadTemplate) + 2 * ThreadChamfer + InsertRadius;
                            if (Blunted)
                            {
                                return $"G0 X{(intChamferStartX + 2 * GeometryMath.ChamferRadiusLengths(45, InsertRadius + BluntSize).X).NC()} Z1. S180 M3\n" +
                                       $"G1 Z0. F0.1\n" +
                                       $"X{intChamferStartX.NC()} R{(InsertRadius + BluntSize).NC()}\n" +
                                       $"X{Thread.BsppHoleDiameter(CurrentThreadTemplate).NC()} A45. R{(InsertRadius + BluntSize).NC()}\n" +
                                       $"G1 Z{EndPointZ.NC()}";
                            }
                            else
                            {
                                return $"G0 X{intChamferStartX.NC()} Z1. S180 M3\n" +
                                       $"G1 Z0. F0.1\n" +
                                       $"X{Thread.BsppHoleDiameter(CurrentThreadTemplate).NC()} C{(ThreadChamfer + InsertRadius / 2).NC()}\n" +
                                       $"G1 Z{EndPointZ.NC()}";
