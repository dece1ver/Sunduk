    /// <summary>
    /// Возвращает результат расчёта (Gost19257Result | Gost19258Result) или null,
    /// если поле/степень не выбраны либо стандарт не метрический.
    /// </summary>
    private object? GostResult
    {
        get
        {
            if (ThreadStandard != ThreadStandard.Metric) return null;
            if (ThreadPosition is null || Grade is null) return null;
            if (!Thread.Valid(ThreadDiameter, ThreadPitch)) return null;

            try
            {
                return ThreadType == CuttingType.Internal
                    ? Thread.GetGost19257(ThreadDiameter, ThreadPitch, ThreadPosition.Value, Grade.Value)
                    : (object)Thread.GetGost19258(ThreadDiameter, ThreadPitch, ThreadPosition.Value, Grade.Value);
            }
            catch
            {
                return null;
            }
        }
    }

