@inject IDialogService DialogService
@inject ThreadTurningState State
<style>
    .tl {
        padding: 0px 15px 0px 0px;
    }

    .monofield {
        font-family: 'Roboto Mono', monospace;
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-3">
    <MudGrid Spacing="1">
        <MudItem xs="12" sm="4">
            <MudSelect Label="Стандарт" T="ThreadStandard" Value="ThreadStandard" Variant="Variant.Filled" ValueChanged="OnStandardChanged">
                <MudSelectItem Value="@(ThreadStandard.Metric)">@(ThreadStandard.Metric.Description())</MudSelectItem>
                <MudSelectItem Value="@(ThreadStandard.BSPP)">@(ThreadStandard.BSPP.Description())</MudSelectItem>
                <MudSelectItem Value="@(ThreadStandard.Trapezoidal)">@(ThreadStandard.Trapezoidal.Description())</MudSelectItem>
                <MudSelectItem Value="@(ThreadStandard.NPT)">@(ThreadStandard.NPT.Description())</MudSelectItem>
                <MudSelectItem Value="@(ThreadStandard.BSPT)">@(ThreadStandard.BSPT.Description())</MudSelectItem>
                <MudSelectItem Value="@(ThreadStandard.UNC)">@(ThreadStandard.UNC.Description())</MudSelectItem>
                <MudSelectItem Value="@(ThreadStandard.UNF)">@(ThreadStandard.UNF.Description())</MudSelectItem>
                <MudSelectItem Value="@(ThreadStandard.UNEF)">@(ThreadStandard.UNEF.Description())</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelectExtended T="string"
                               Label="Шаблон"
                               Variant="Variant.Filled"
                               ItemCollection="@ThreadTemplates"
                               Value="@CurrentThreadTemplate"
                               ValueChanged="OnTemplateChanged"
                               SearchBox="true"
                               SearchBoxClearable="true"
                               SearchBoxPlaceholder="Поиск..."
                               Virtualize="true"
                               Clearable="true"
                               AnchorOrigin="Origin.BottomCenter" />
        </MudItem>
        @if (ThreadStandard == ThreadStandard.Metric)
        {
            <MudItem xs="6" sm="2">
                <MudSelect T="int?"
                           Value="Grade"
                           Label="Допуск"
                           ValueChanged="@(v => Grade = v)"
                           Variant="Variant.Filled"
                           Clearable="true">
                    @foreach (var val in Enumerable.Range(3, 8))
                    {
                        <MudSelectItem T="int?" Value="@((int?)val)">@val</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="6" sm="2">
                <MudSelect T="Thread.ThreadPosition?"
                           Value="ThreadPosition"
                           ValueChanged="@(v => ThreadPosition = v)"
                           Label="Поле"
                           Variant="Variant.Filled"
                           Clearable="true">
                    @if (ThreadType == CuttingType.External)
                    {
                        <MudSelectItem T="Thread.ThreadPosition?" Value="@((Thread.ThreadPosition?)Thread.ThreadPosition.d)">d</MudSelectItem>
                        <MudSelectItem T="Thread.ThreadPosition?" Value="@((Thread.ThreadPosition?)Thread.ThreadPosition.e)">e</MudSelectItem>
                        <MudSelectItem T="Thread.ThreadPosition?" Value="@((Thread.ThreadPosition?)Thread.ThreadPosition.f)">f</MudSelectItem>
                        <MudSelectItem T="Thread.ThreadPosition?" Value="@((Thread.ThreadPosition?)Thread.ThreadPosition.g)">g</MudSelectItem>
                        <MudSelectItem T="Thread.ThreadPosition?" Value="@((Thread.ThreadPosition?)Thread.ThreadPosition.h)">h</MudSelectItem>
                    }
                    else
                    {
                        <MudSelectItem T="Thread.ThreadPosition?" Value="@((Thread.ThreadPosition?)Thread.ThreadPosition.E)">E</MudSelectItem>
                        <MudSelectItem T="Thread.ThreadPosition?" Value="@((Thread.ThreadPosition?)Thread.ThreadPosition.F)">F</MudSelectItem>
                        <MudSelectItem T="Thread.ThreadPosition?" Value="@((Thread.ThreadPosition?)Thread.ThreadPosition.G)">G</MudSelectItem>
                        <MudSelectItem T="Thread.ThreadPosition?" Value="@((Thread.ThreadPosition?)Thread.ThreadPosition.H)">H</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        }

        <MudItem xs="12">
            <MudField Label="Параметры резьбы" Variant="Variant.Filled" Underline="false">
                <MudGrid Spacing="0">
                    <MudHidden Breakpoint="Breakpoint.Xs">
                        <MudItem xs="12" sm="3" md="2">
                            <MudRadioGroup @bind-Value="@ThreadType" Class="ml-0 d-flex justify-center">
                                <div>
                                    <div class="d-block">
                                        <MudRadio Value="@(CuttingType.External)" Color="Color.Primary">Наружная</MudRadio>
                                    </div>
                                    <div class="d-block">
                                        <MudRadio Value="@(CuttingType.Internal)" Color="Color.Primary">Внутренняя</MudRadio>
                                    </div>
                                </div>
                            </MudRadioGroup>
                        </MudItem>
                        <MudItem xs="12" sm="9" md="10" Class="mt-n3">
                            <MudTextField @bind-Value="ThreadDiameterString" Label="Диаметр" Adornment="Adornment.End" AdornmentText="мм" Variant="Variant.Text" Immediate="true" />
                            <MudTextField @bind-Value="ThreadPitchString" Label="Шаг" Adornment="Adornment.End" AdornmentText="мм" Variant="Variant.Text" Immediate="true" />
                        </MudItem>
                    </MudHidden>
                    <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                        <MudItem xs="12" sm="4" md="3">
                            <MudRadioGroup @bind-Value="ThreadType" Class="mt-2 mb-n2 d-flex justify-center">
                                <MudRadio Value="@(CuttingType.External)" Color="Color.Primary">Наружная</MudRadio>
                                <MudRadio Value="@(CuttingType.Internal)" Color="Color.Primary">Внутренняя</MudRadio>
                            </MudRadioGroup>
                        </MudItem>
                        <MudItem xs="12" sm="8" md="9">
                            <MudTextField @bind-Value="ThreadDiameterString" Label="Диаметр" Adornment="Adornment.End" AdornmentText="мм" Variant="Variant.Text" Immediate="true" />
                            <MudTextField @bind-Value="ThreadPitchString" Label="Шаг" Adornment="Adornment.End" AdornmentText="мм" Variant="Variant.Text" Immediate="true" />
                        </MudItem>
                    </MudHidden>
                </MudGrid>
            </MudField>
        </MudItem>

    </MudGrid>

    @if (Sunduk.PWA.Infrastructure.Templates.Thread.Valid(ThreadDiameter, ThreadPitch))
    {
        @if (ThreadStandard is ThreadStandard.NPT or ThreadStandard.BSPT)
        {
            <MudItem Class="mt-4 xs=12">
                <MudPaper Outlined="true" Class="mt-1">
                    <div style="display: flex; justify-content: center; align-items: center; height: 200px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="600" height="300" viewBox="@($"0 0 600 300")">
                            <g transform="scale(2) translate(200,100)">
                                @if (ThreadType == CuttingType.External)
                                {
                                    <path d="M 0,-34.43 L -6.4,-41.63 L -72,-43.68011244269665 L -120,-43.68011244269665 L -120,-0 L 0,-0 L 0,-34.43" stroke="#FF5722" stroke-width="2" fill="none" />
                                }
                                @if (ThreadType == CuttingType.Internal)
                                {
                                    <path d="M 0,-43.64 L -6.4,-36.44 L -72,-34.389887557303354 L -120,-34.389887557303354 L -120,-60 L 0,-60 L 0,-43.64 " stroke="#FF5722" stroke-width="2" fill="none" />
                                }
                                <path stroke="white" stroke-dasharray="10 5" stroke-width="1" fill="none" d="M -180,0 L 60,0" />
                                <path stroke="white" stroke-width="1" fill="none" d="M 52,3 L 60,0 L 52,-3" />
                                <text x="3" y="@(ThreadType == CuttingType.External ? -30 : -45)" fill="white" style="font-family: 'Roboto Mono', monospace;" font-size="8">@($"X{Contour[0].X?.NC()} Z{Contour[0].Z?.NC()}")</text>
                                <text x="@(ThreadType == CuttingType.External ? -5 : -3)" y="@(ThreadType == CuttingType.External ? -45 : -30)" fill="white" style="font-family: 'Roboto Mono', monospace;" font-size="8">@($"X{Contour[1].X?.NC()} Z{Contour[1].Z?.NC()}")</text>
                                <text x="-80" y="@(ThreadType == CuttingType.External ? -50 : -25)" fill="white" style="font-family: 'Roboto Mono', monospace;" font-size="8">@($"X{Contour[2].X?.NC()} Z{Contour[2].Z?.NC()}")</text>
                                <text x="35" y="12" fill="white" style="font-family: 'Roboto Mono', monospace;" font-size="10">Z+</text>
                            </g>
                        </svg>
                    </div>
                </MudPaper>
            </MudItem>
        }

        <MudItem Class="mt-4" xs="12">
            <MudField Label="Информация" Variant="Variant.Filled" Underline="false" Class="mt-n1">
                <table>
                    <tr>
                        <td class="tl"><MudText Typo="Typo.caption">Верхний диаметр:</MudText></td>
                        <td><MudText Typo="Typo.caption">@(ThreadDiameter.ToPrettyString(3)) мм</MudText></td>
                    </tr>
                    <tr>
                        <td class="tl"><MudText Typo="Typo.caption">Нижний диаметр:</MudText></td>
                        <td><MudText Typo="Typo.caption">@((ThreadDiameter - 2 * Thread.ProfileHeight(ThreadStandard, ThreadType, ThreadPitch)).ToPrettyString(3)) мм</MudText></td>
                    </tr>
                    @if (ThreadType == CuttingType.Internal && ThreadStandard == ThreadStandard.Metric)
                    {
                        <tr>
                            <td class="tl"><MudText Typo="Typo.caption">Сверло под резьбу:</MudText></td>
                            <td><MudText Typo="Typo.caption">@DrillDiameterDisplay</MudText></td>
                        </tr>
                    }
                    <tr>
                        <td class="tl"><MudText Typo="Typo.caption">Шаг:</MudText></td>
                        <td><MudText Typo="Typo.caption">@(ThreadPitch.ToPrettyString() + (ThreadStandard is ThreadStandard.BSPP or ThreadStandard.BSPT or ThreadStandard.NPT or ThreadStandard.UNC or ThreadStandard.UNF or ThreadStandard.UNEF ? $" ({ThreadPitch.ToTpi()} TPI)" : ""))</MudText></td>
                    </tr>
                    <tr>
                        <td class="tl"><MudText Typo="Typo.caption">Общая высота профиля:</MudText></td>
                        <td><MudText Typo="Typo.caption">@($"{Passes.Sum().ToString("G3").Replace(",", ".")}") мм</MudText></td>
                    </tr>
                    <tr>
                        <td class="tl"><MudText Typo="Typo.caption">Угол подъема винтовой линии:</MudText></td>
                        <td><MudText Typo="Typo.caption">@(ThreadAngle?.ToString("G3").Replace(",", ".")) °</MudText></td>
                    </tr>
                    <tr>
                        <td class="tl"><MudText Typo="Typo.caption">Угол опорной пластины:</MudText></td>
                        <td><MudText Typo="Typo.caption">@(ThreadAngle?.ToString("N0").Replace(",", ".")) °</MudText></td>
                    </tr>
                    <tr>
                        <td class="tl"><MudText Typo="Typo.caption">Количество проходов:</MudText></td>
                        <td><MudText Typo="Typo.caption">@(Passes.Length)</MudText></td>
                    </tr>
                    <tr>
                        <td class="tl"><MudText Typo="Typo.caption">Обороты шпинделя:</MudText></td>
                        <td><MudText Typo="Typo.caption">@SpindleSpeed об/мин</MudText></td>
                    </tr>

                    @if (ThreadStandard == ThreadStandard.Metric && GostResult is not null)
                    {
                        bool _isInternal = ThreadType == CuttingType.Internal;
                        string _gostLabel = _isInternal ? "Диаметр отверстия (ГОСТ 19257)" : "Диаметр стержня (ГОСТ 19258)";
                        string _viscousLabel = _isInternal ? "Диаметр отверстия (вязкие)" : "Диаметр стержня (вязкие)";

                        string _gostTooltip = _isInternal
                            ? "Серый чугун ГОСТ 1412-85; стали ГОСТ 380-94, ГОСТ 1050-88, ГОСТ 4543-71, " +
                              "ГОСТ 5632-72 (кроме сплавов на никелевой основе), ГОСТ 20072-74; " +
                              "алюминиевые литейные сплавы ГОСТ 1583-93; медь ГОСТ 859-78"
                            : "Стали ГОСТ 380-71, ГОСТ 4543-71, ГОСТ 1050-88, ГОСТ 10702-78, " +
                              "ГОСТ 5632-72 и ГОСТ 20072-74 (кроме сплавов на никелевой основе); медь ГОСТ 859-78";

                        string _viscousTooltip = _isInternal
                            ? "Сплавы магния ГОСТ 804-93; сплавы алюминиевые ГОСТ 4784-97; " +
                              "латуни ГОСТ 15527-70; титановые сплавы; стали и сплавы высоколегированные, " +
                              "коррозионностойкие, жаростойкие, жаропрочные (на никелевой основе) " +
                              "ГОСТ 5632-72, ГОСТ 20072-74"
                            : "Латуни ГОСТ 15527-70; титановые сплавы; стали и сплавы высоколегированные, " +
                              "коррозионностойкие, жаростойкие, жаропрочные (на никелевой основе) " +
                              "ГОСТ 5632-72, ГОСТ 20072-74";

                        string? _gostValue = null;
                        if (_isInternal)
                        {
                            var _n = Thread.GetHoleNominalForField(ThreadDiameter, ThreadPitch, ThreadPosition!.Value, Grade!.Value);
                            if (_n is { } _hn)
                                _gostValue = $"{_hn.Nominal.ToPrettyString(2)}  (+{_hn.Dev.ToPrettyString(2)})";
                        }
                        else
                        {
                            var _n = Thread.GetRodNominalForField(ThreadDiameter, ThreadPitch, ThreadPosition!.Value, Grade!.Value);
                            if (_n is { } _rn)
                                _gostValue = $"{_rn.Nominal.ToPrettyString(2)}  ({_rn.Dev.ToPrettyString(2)})";
                        }

                        string? _viscousValue = null;
                        if (_isInternal && GostResult is Thread.Gost19257Result _hole)
                        {
                            double _tol = _hole.D1max - _hole.D1min;
                            _viscousValue = $"{_hole.D1min.ToPrettyString(3)}  ({(_tol >= 0 ? "+" : "")}{_tol.ToPrettyString(3)})";
                        }
                        else if (!_isInternal && GostResult is Thread.Gost19258Result _rod)
                        {
                            double _tol = _rod.dmin - _rod.dmax;
                            _viscousValue = $"{_rod.dmax.ToPrettyString(3)}  ({(_tol >= 0 ? "+" : "")}{_tol.ToPrettyString(3)})";
                        }

                        <tr>
                            <td colspan="2"><MudDivider Class="my-1" /></td>
                        </tr>
                        <tr>
                            <td class="tl"><MudText Typo="Typo.caption" Color="Color.Primary">Поле допуска:</MudText></td>
                            <td><MudText Typo="Typo.caption">@GostFieldLabel</MudText></td>
                        </tr>

                        if (_gostValue is not null)
                        {
                            <tr>
                                <td class="tl">
                                    <MudText Typo="Typo.caption"
                                             Style="cursor: pointer; text-decoration: underline dotted;"
                                             @onclick="@(async () => await OpenMaterialsDialog(_gostLabel, GostMaterials(_isInternal)))">
                                        @_gostLabel:
                                    </MudText>
                                </td>
                                <td><MudText Typo="Typo.caption">@_gostValue</MudText></td>
                            </tr>
                        }

                        if (_viscousValue is not null)
                        {
                            <tr>
                                <td class="tl">
                                    <MudText Typo="Typo.caption"
                                             Style="cursor: pointer; text-decoration: underline dotted;"
                                             @onclick="@(async () => await OpenMaterialsDialog(_viscousLabel, ViscousMaterials(_isInternal)))">
                                        @_viscousLabel:
                                    </MudText>
                                </td>
                                <td><MudText Typo="Typo.caption">@_viscousValue</MudText></td>
                            </tr>
                        }
                    }
                </table>
            </MudField>
        </MudItem>

        <MudExpansionPanel Text="Проходы">
            <MudItem xs="12">
                <table>
                    <tr>
                        <td class="tl"><MudText>Проход</MudText></td>
                        <td class="tl"><MudText>Съем</MudText></td>
                        <td><MudText>Накопленный</MudText></td>
                    </tr>
                    @foreach ((double value, int index) in Passes.Select((v, i) => (v, i)))
                    {
                        <tr>
                            <td><MudText Typo="Typo.caption">@(index + 1)</MudText></td>
                            <td><MudText Typo="Typo.caption">@value.ToString("N3").Replace(",", ".")</MudText></td>
                            <td><MudText Typo="Typo.caption">@TotalPasses[index].ToString("N3").Replace(",", ".")</MudText></td>
                        </tr>
                    }
                </table>
            </MudItem>
        </MudExpansionPanel>

        <MudExpansionPanel Text="Пример программы для Fanuc">
            <MudItem xs="12">
                <MudTextField Variant="Variant.Outlined" Style="font-family: 'Roboto Mono', monospace; font-size: small;" Margin="Margin.Dense" ReadOnly="true" Lines="3" Value="@($"G0 X{ApproachDiameter} Z{StartPointZ.NC()} S{SpindleSpeed.Round(100)} M3 G97\n" +
                                                                                                                                                                                                                          $"G76 P0201{Thread.Profile(ThreadStandard)} Q{Passes[^2].Microns()} R{Passes[^1].NC()}\n" +
                                                                                                                                                                                                                          $"G76 X{EndDiameter} Z{EndPointZ.NC()} P{Thread.ProfileHeight(ThreadStandard, ThreadType, ThreadPitch).Microns()} Q{Passes[0].Microns()}{ThreadShift} F{ThreadPitch.NC()}")">
                </MudTextField>
            </MudItem>
        </MudExpansionPanel>

        <MudExpansionPanel Text="Пример проточки под резьбу">
            <MudGrid>
                <MudItem xs="12">
                    <MudField Label="Параметры" Variant="Variant.Outlined" InnerPadding="false">
                        <MudGrid Spacing="1">
                            <MudItem xs="@(Blunted ? 6 : 12)" sm="@(Blunted ? 3 : 4)">
                                <MudSwitch Class="mb-1 mt-3 ml-1" @bind-Value="@Blunted" Color="Color.Primary">Скруглить</MudSwitch>
                            </MudItem>
                            <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                                @if (Blunted)
                                {
                                    <MudItem xs="6" sm="@(Blunted ? 3 : 4)">
                                        <MudTextField Class="mb-n2 mt-0" T="double" @bind-Value="BluntSize" Label="Скругление" Adornment="Adornment.End" AdornmentText="мм" Variant="Variant.Filled" Immediate="true" Converter="Util.DoubleConverter" Underline="false" />
                                    </MudItem>
                                }
                                <MudItem Class="mb-2" xs="6" sm="@(Blunted ? 3 : 4)">
                                    <MudTextField T="double" @bind-Value="ThreadChamfer" Label="Фаска" Adornment="Adornment.End" AdornmentText="мм" Variant="Variant.Filled" Immediate="true" Converter="Util.DoubleConverter" Underline="false" />
                                </MudItem>
                                <MudItem Class="mb-2" xs="6" sm="@(Blunted ? 3 : 4)">
                                    <MudTextField T="double" @bind-Value="InsertRadius" Label="Радиус пластины" Adornment="Adornment.End" AdornmentText="мм" Variant="Variant.Filled" Immediate="true" Converter="Util.DoubleConverter" Underline="false" />
                                </MudItem>
                            </MudHidden>
                            <MudHidden Breakpoint="Breakpoint.Xs">
                                @if (Blunted)
                                {
                                    <MudItem xs="6" sm="@(Blunted ? 3 : 4)" Class="mb-2">
                                        <MudTextField T="double" @bind-Value="BluntSize" Label="Скругление" Adornment="Adornment.End" AdornmentText="мм" Variant="Variant.Filled" Immediate="true" Converter="Util.DoubleConverter" Underline="false" />
                                    </MudItem>
                                }
                                <MudItem Class="mb-2" xs="6" sm="@(Blunted ? 3 : 4)">
                                    <MudTextField T="double" @bind-Value="ThreadChamfer" Label="Фаска" Adornment="Adornment.End" AdornmentText="мм" Variant="Variant.Filled" Immediate="true" Converter="Util.DoubleConverter" Underline="false" />
                                </MudItem>
                                <MudItem Class="mb-2" xs="6" sm="@(Blunted ? 3 : 4)">
                                    <MudTextField T="double" @bind-Value="InsertRadius" Label="Радиус пластины" Adornment="Adornment.End" AdornmentText="мм" Variant="Variant.Filled" Immediate="true" Converter="Util.DoubleConverter" Underline="false" />
                                </MudItem>
                            </MudHidden>
                        </MudGrid>
                    </MudField>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Variant="Variant.Outlined" Style="font-family: 'Roboto Mono', monospace; font-size: small;" Margin="Margin.Dense" ReadOnly="true" Lines="ExampleLines" Value="@(TurningExample)" />
                </MudItem>
            </MudGrid>
        </MudExpansionPanel>
    }
    <MudDialog @bind-IsVisible="_materialsDialogOpen">
        <TitleContent>
            <MudText Typo="Typo.h6">@_materialsDialogTitle</MudText>
        </TitleContent>
        <DialogContent>
            <MudList T="string" Dense="true">
                @foreach (var item in _materialsDialogItems)
                {
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">
                        @item
                    </MudListItem>
                }
            </MudList>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _materialsDialogOpen = false)" Color="Color.Primary">Закрыть</MudButton>
        </DialogActions>
    </MudDialog>
</MudContainer>


@code
{
    System.Threading.CancellationTokenSource _cts = new();
    private bool _materialsDialogOpen = false;
    private string _materialsDialogTitle = "";
    private List<string> _materialsDialogItems = new();

    private async Task OpenMaterialsDialog(string title, IEnumerable<string> items)
    {
        var parameters = new DialogParameters<MaterialsDialog>
        {
            { x => x.Items, items.ToList() }
        };
        var options = new DialogOptions { CloseButton = true, CloseOnEscapeKey = true };
        await DialogService.ShowAsync<MaterialsDialog>(title, parameters, options);
    }

    private IEnumerable<string> GostMaterials(bool isInternal) => isInternal
        ? new[]
        {
        "Серый чугун — ГОСТ 1412-85",
        "Стали — ГОСТ 380-94, ГОСТ 1050-88, ГОСТ 4543-71",
        "Стали — ГОСТ 5632-72 (кроме сплавов на никелевой основе)",
        "Стали — ГОСТ 20072-74",
        "Алюминиевые литейные сплавы — ГОСТ 1583-93",
        "Медь — ГОСТ 859-78",
        }
        : new[]
        {
        "Стали — ГОСТ 380-71, ГОСТ 4543-71, ГОСТ 1050-88, ГОСТ 10702-78",
        "Стали — ГОСТ 5632-72 (кроме сплавов на никелевой основе)",
        "Стали — ГОСТ 20072-74",
        "Медь — ГОСТ 859-78",
        };

    private IEnumerable<string> ViscousMaterials(bool isInternal) => isInternal
        ? new[]
        {
        "Сплавы магния — ГОСТ 804-93",
        "Сплавы алюминиевые — ГОСТ 4784-97",
        "Латуни — ГОСТ 15527-70",
        "Титановые сплавы",
        "Стали и сплавы высоколегированные, коррозионностойкие, жаростойкие, жаропрочные (на никелевой основе) — ГОСТ 5632-72, ГОСТ 20072-74",
        }
        : new[]
        {
        "Латуни — ГОСТ 15527-70",
        "Титановые сплавы",
        "Стали и сплавы высоколегированные, коррозионностойкие, жаростойкие, жаропрочные (на никелевой основе) — ГОСТ 5632-72, ГОСТ 20072-74",
        };

    private string DrillDiameterDisplay
    {
        get
        {
            if (ThreadType != CuttingType.Internal) return string.Empty;
            return ThreadStandard switch
            {
                ThreadStandard.Metric
                    => $"{Thread.DrillDiameter(ThreadDiameter, ThreadPitch).ToPrettyString(2)} мм",
                ThreadStandard.BSPP when Thread.BsppHoleDiameter(CurrentThreadTemplate) > 0
                    => $"{Thread.BsppHoleDiameter(CurrentThreadTemplate).ToPrettyString(2)} мм",
                ThreadStandard.NPT when Thread.NptHoleDiameter(CurrentThreadTemplate) > 0
                    => $"{Thread.NptHoleDiameter(CurrentThreadTemplate).ToPrettyString(2)} мм",
                _ => "—",
            };
        }
    }

    private async Task<IEnumerable<string>> Search(string value, System.Threading.CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return ThreadTemplates;

        await Task.Delay(200, token);
        if (token.IsCancellationRequested) return [];

        return await Task.Run(() =>
            ThreadTemplates
                .Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase))
                .ToList()
        , token);
    }

    public ICollection<string> ThreadTemplates
    {
        get
        {
            return ThreadStandard switch
            {
                ThreadStandard.Metric => Thread.MetricTemplates,
                ThreadStandard.BSPP => Thread.BsppTemplates,
                ThreadStandard.Trapezoidal => Thread.TrapezoidalTemplates,
                ThreadStandard.NPT => Thread.NptTemplates,
                ThreadStandard.BSPT => ThreadType is CuttingType.External ? Thread.BsptTemplatesEx : Thread.BsptTemplatesIn,
                ThreadStandard.UNC => Thread.UncTemplates,
                ThreadStandard.UNF => Thread.UnfTemplates,
                ThreadStandard.UNEF => Thread.UnefTemplates,
                _ => new HashSet<string>()
            };
        }
    }

