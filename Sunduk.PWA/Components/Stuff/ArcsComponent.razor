@using MudBlazor.Extensions
<MudSwipeArea OnSwipeEnd="@(e => OnSwipe(e.SwipeDirection))" Style="touch-action: pan-y;">
    <MudTabs Elevation="2" @ref="tabs" Style="font-size: small">
        <MudTabPanel Text="Скругление">
            <RadiusComponent />
        </MudTabPanel>
        <MudTabPanel Text="@("\"Ниппель\"")">
            <NippleComponent />
        </MudTabPanel>
        <MudTabPanel Text="@("\"Затвор\"")">
            <Arc2Component />
        </MudTabPanel>
    </MudTabs>
</MudSwipeArea>

@code
{
    MudTabs tabs = default!;

    private void OnSwipe(SwipeDirection direction)
    {
        if (direction == SwipeDirection.LeftToRight)
        {
            if (tabs.GetState(x => x.ActivePanelIndex) > 0)
            {
                tabs.ActivatePanelAsync(tabs.GetState(x => x.ActivePanelIndex) - 1);
            }
        }
        else if (direction == SwipeDirection.RightToLeft)
        {
            if (tabs.GetState(x => x.ActivePanelIndex) < 2)
            {
                tabs.ActivatePanelAsync(tabs.GetState(x => x.ActivePanelIndex) + 1);
            }
        }
    }
}