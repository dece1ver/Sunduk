@using System.Threading.Tasks
@inject ChamferState State
<style>
    .monofield {
        font-family: 'Roboto Mono', monospace;
    }
</style>
    <MudGrid Spacing="1" Class="pa-2">
        <MudItem xs="12" sm="6">
            <MudField Label="Параметры фаски" Variant="Variant.Filled" Underline="false" Class="mt-1"
                @onfocusout="(() => CurrentImage = ChamferType == Chamfer.External ? Images.ExternalChamfer : Images.InternalChamfer)">
                <MudGrid Spacing="0">
                    <MudItem xs="12">
                        <MudRadioGroup ValueChanged="OnChamferTypeChanged" T="Chamfer" Class="mb-n2 d-flex justify-center">
                            <MudRadio Value="@Chamfer.External" Color="Color.Primary">Наружная</MudRadio>
                            <MudRadio Value="@Chamfer.Internal" Color="Color.Primary">Внутренняя</MudRadio>
                        </MudRadioGroup>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_ChamferEndDiameter" T="string" Label="Конечный диаметр" Adornment="Adornment.End" AdornmentText="мм" Immediate="true"
                                      @onfocus="() => CurrentImage = ChamferType == Chamfer.External ? Images.ExternalEndDiameter : Images.InternalEndDiameter" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_ChamferSize" @onfocusin="@(() => calcStartDiam = true)" T="string" Label="Глубина" Adornment="Adornment.End" AdornmentText="мм" Immediate="true"
                                      @onfocus="() => CurrentImage = ChamferType == Chamfer.External ? Images.ExternalChamferSize : Images.InternalChamferSize" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_Angle" T="string" Label="Угол" Adornment="Adornment.End" AdornmentText="°" Immediate="true"
                                      @onfocus="() => CurrentImage = ChamferType == Chamfer.External ? Images.ExternalChamferAngle : Images.InternalChamferAngle" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_ChamferStartDiameter" @onfocusin="@(() => calcStartDiam = false)" T="string" Label="Начальный диаметр" Immediate="true" Adornment="Adornment.End" AdornmentText="мм"
                                      @onfocus="() => CurrentImage = ChamferType == Chamfer.External ? Images.ExternalStartDiameter : Images.InternalStartDiameter" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>
            </MudField>
        </MudItem>
        <MudHidden Breakpoint="Breakpoint.Xs">
            <MudItem xs="12" sm="6">
                <MudCard Elevation="0" Outlined="true" Class="mt-1 mb-2 rounded-0">
                    <MudCardContent>
                        @if (CurrentImage == Images.ExternalChamfer)
                        {
                            <center>
                                <img src="/img/stuffimages/chamfer/ext_chamfer_n.svg" asp-append-version="true" width="@_imgWidth" height="@_imgHeigth" />
                            </center>
                        }
                        @if (CurrentImage == Images.InternalChamfer)
                        {
                            <center>
                                <img src="/img/stuffimages/chamfer/int_chamfer_n.svg" asp-append-version="true" width="@_imgWidth" height="@_imgHeigth" />
                            </center>
                        }
                        @if (CurrentImage == Images.ExternalChamferAngle)
                        {
                            <center>
                                <img src="/img/stuffimages/chamfer/ext_chamfer_angle_n.svg" asp-append-version="true" width="@_imgWidth" height="@_imgHeigth" />
                            </center>
                        }
                        @if (CurrentImage == Images.ExternalChamferSize)
                        {
                            <center>
                                <img src="/img/stuffimages/chamfer/ext_chamfer_size_n.svg" asp-append-version="true" width="@_imgWidth" height="@_imgHeigth" />
                            </center>
                        }
                        @if (CurrentImage == Images.ExternalStartDiameter)
                        {
                            <center>
                                <img src="/img/stuffimages/chamfer/ext_chamfer_diam_n.svg" asp-append-version="true" width="@_imgWidth" height="@_imgHeigth" />
                            </center>
                        }
                        @if (CurrentImage == Images.ExternalEndDiameter)
                        {
                            <center>
                                <img src="/img/stuffimages/chamfer/ext_part_diam_n.svg" asp-append-version="true" width="@_imgWidth" height="@_imgHeigth" />
                            </center>
                        }
                        @if (CurrentImage == Images.ExternalToolRadius)
                        {
                            <center>
                                <img src="/img/stuffimages/chamfer/ext_tool_radius_n.svg" asp-append-version="true" width="@_imgWidth" height="@_imgHeigth" />
                            </center>
                        }
                        @if (CurrentImage == Images.InternalChamferAngle)
                        {
                            <center>
                                <img src="/img/stuffimages/chamfer/int_chamfer_angle_n.svg" asp-append-version="true" width="@_imgWidth" height="@_imgHeigth" />
                            </center>
                        }
                        @if (CurrentImage == Images.InternalChamferSize)
                        {
                            <center>
                                <img src="/img/stuffimages/chamfer/int_chamfer_size_n.svg" asp-append-version="true" width="@_imgWidth" height="@_imgHeigth" />
                            </center>
                        }
                        @if (CurrentImage == Images.InternalStartDiameter)
                        {
                            <center>
                                <img src="/img/stuffimages/chamfer/int_chamfer_diam_n.svg" asp-append-version="true" width="@_imgWidth" height="@_imgHeigth" />
                            </center>
                        }
                        @if (CurrentImage == Images.InternalEndDiameter)
                        {
                            <center>
                                <img src="/img/stuffimages/chamfer/int_part_diam_n.svg" asp-append-version="true" width="@_imgWidth" height="@_imgHeigth" />
                            </center>
                        }
                        @if (CurrentImage == Images.InternalToolRadius)
                        {
                            <center>
                                <img src="/img/stuffimages/chamfer/int_tool_radius_n.svg" asp-append-version="true" width="@_imgWidth" height="@_imgHeigth" />
                            </center>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <div>
                <img src="/img/stuffimages/chamfer/ext_chamfer_n.svg" asp-append-version="true" width="0" height="0" />
                <img src="/img/stuffimages/chamfer/int_chamfer_n.svg" asp-append-version="true" width="0" height="0" />
                <img src="/img/stuffimages/chamfer/ext_chamfer_angle_n.svg" asp-append-version="true" width="0" height="0" />
                <img src="/img/stuffimages/chamfer/ext_chamfer_size_n.svg" asp-append-version="true" width="0" height="0" />
                <img src="/img/stuffimages/chamfer/ext_chamfer_diam_n.svg" asp-append-version="true" width="0" height="0" />
                <img src="/img/stuffimages/chamfer/ext_part_diam_n.svg" asp-append-version="true" width="0" height="0" />
                <img src="/img/stuffimages/chamfer/ext_tool_radius_n.svg" asp-append-version="true" width="0" height="0" />
                <img src="/img/stuffimages/chamfer/int_chamfer_angle_n.svg" asp-append-version="true" width="0" height="0" />
                <img src="/img/stuffimages/chamfer/int_chamfer_size_n.svg" asp-append-version="true" width="0" height="0" />
                <img src="/img/stuffimages/chamfer/int_chamfer_diam_n.svg" asp-append-version="true" width="0" height="0" />
                <img src="/img/stuffimages/chamfer/int_part_diam_n.svg" asp-append-version="true" width="0" height="0" />
                <img src="/img/stuffimages/chamfer/int_tool_radius_n.svg" asp-append-version="true" width="0" height="0" />
            </div>
        </MudHidden>
        <MudItem xs="12" sm="12">
            <MudField Label="Расчет" Variant="Variant.Filled" Underline="false" Class="mt-n1"
            @onfocusout="(() => CurrentImage = ChamferType == Chamfer.External ? Images.ExternalChamfer : Images.InternalChamfer)">
                <MudGrid Spacing="1">
                    <MudHidden Breakpoint="Breakpoint.Xs">
                        <MudItem xs="12" sm="6" Class="mt-2">
                            <MudTextField @bind-Value="_ChamferInsertRadius" T="string" Label="Радиус пластины" Immediate="true" Adornment="Adornment.End" AdornmentText="мм" Class="mr-3"
                                          @onfocus="() => CurrentImage = ChamferType == Chamfer.External ? Images.ExternalToolRadius : Images.InternalToolRadius" Margin="Margin.Dense">
                            </MudTextField>
                        </MudItem>
                    </MudHidden>
                    <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_ChamferInsertRadius" T="string" Label="Радиус пластины" Immediate="true" Adornment="Adornment.End" AdornmentText="мм"
                                          @onfocus="() => CurrentImage = ChamferType == Chamfer.External ? Images.ExternalToolRadius : Images.InternalToolRadius" Margin="Margin.Dense">
                            </MudTextField>
                        </MudItem>
                    </MudHidden>
                    <MudItem xs="12" sm="6">
                        <MudRadioGroup ValueChanged="OnCalculationChanged" T="Calculation" Class="d-flex justify-center">
                            <MudRadio Value="@Calculation.Simplified" Color="Color.Primary">Упрощенный</MudRadio>
                            <MudRadio Value="@Calculation.Precise" Color="Color.Primary">Точный</MudRadio>
                        </MudRadioGroup>
                    </MudItem>
                    @if (Angle != 45 && Angle != 0 && CalculationType == Calculation.Simplified)
                    {
                    <MudItem xs="12">
                            <MudAlert Class="rounded-0" Severity="Severity.Warning" Icon="@Icons.Material.Filled.WarningAmber">Не рекомендуется использовать упрощенный расчет для углов отличных от 45°</MudAlert>
                    </MudItem>
                    }
                </MudGrid>
            </MudField>
        </MudItem>
        <MudItem xs="12">
            <MudField Label="Результат" Variant="Variant.Filled" Underline="false">
                <MudGrid Spacing="1">
                    
                    <MudItem xs="12" Class="mt-2">
                        @if (ValidResult() && ChamferInsertRadius > 0)
                        {
                            <MudText Typo="Typo.body2">@($"Начальный диаметр с учетом радиуса пластины: {ChamferStartDiamWithShift.ToPrettyString()} мм")</MudText>
                        }
                        @if (!ValidResult() || ChamferInsertRadius == 0)
                        {
                            <MudText Typo="Typo.body2">@($"Начальный диаметр с учетом радиуса пластины: -")</MudText>
                        }
                    </MudItem>
                    <MudItem xs="12">
                        @if (ValidResult() && ChamferInsertRadius > 0)
                        {
                            <MudText Typo="Typo.body2">@($"Глубина с учетом радиуса пластины: {ChamferSizeWithShift.ToPrettyString()} мм")</MudText>
                        }
                        @if (!ValidResult() || ChamferInsertRadius == 0)
                        {
                            <MudText Typo="Typo.body2">@($"Глубина с учетом радиуса пластины: -")</MudText>
                        }
                    </MudItem>
                </MudGrid>
            </MudField>
        </MudItem>
        @if (ValidResult())
        {
            <MudItem xs="12">
                <MudExpansionPanel Class="rounded-0" Text="Пример программы для Fanuc" ExpandedChanged="OnPanelExpanded">
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudRadioGroup T="bool" @bind-Value="showClassicChamfer" Class="ma-n1">
                                <MudRadio Value="true" Color="Color.Primary">Обычная</MudRadio>
                                <MudRadio Value="false" Color="Color.Primary">Обратная</MudRadio>
                            </MudRadioGroup>
                        </MudItem>
                        <MudItem xs="6" md="4">
                            <MudSwitch @bind-Value="@RoundCorners" Label="Скруглить углы" Color="Color.Primary" Class="ma-0"/>
                        </MudItem>
                        <MudItem xs="6" md="4">
                            @if (RoundCorners)
                            {
                                <MudTextField @bind-Value="_RoundCorner" T="string" Label="Радиус скругления" Variant="Variant.Text" Margin="Margin.Dense" Immediate="true" Adornment="Adornment.End" AdornmentText="мм" Class="ma-0" Underline="false"/>
                            }
                        </MudItem>
                    </MudGrid>
                    <MudItem xs="12">
                        <MudTextField Variant="Variant.Outlined" Style="font-family: 'Roboto Mono', monospace;" Lines="ExampleLines" AutoGrow="true" Value="@ChamferExample" ReadOnly="true"  />
                    </MudItem>
                </MudExpansionPanel>
            </MudItem>
        }
    </MudGrid>

@code
{
    [Inject] IJSRuntime JS { get; set; } = default!;

    readonly int _imgHeigth = 249;
    readonly int _imgWidth = 270;

    bool calcStartDiam { get => State.CalcStartDiam; set => State.CalcStartDiam = value; }
    bool showClassicChamfer { get => State.ShowClassicChamfer; set => State.ShowClassicChamfer = value; }

    public string ChamferExample
    {
        get
        {
            // классическая без скрулгений
            if (ValidResult() && !RoundCorners && showClassicChamfer)
            {
                return
                    $"G0 X{(ChamferStartDiamWithShift).NC()} Z1. S180 M3\n" +
                    $"G1 Z0. F0.1\n" +
                    $"X{ChamferEndDiameter.NC()} A{(ChamferType == Chamfer.External ? '-' : string.Empty)}{(Angle).NC()}";
            }
            // обратная без скруглений
            else if (ValidResult() && !RoundCorners && !showClassicChamfer)
            {
                switch (ChamferType)
                {
                    case Chamfer.External:
                        return
                        $"G0 X{(ChamferEndDiameter + 1).NC(1)} Z-{(ChamferSizeWithShift).NC()} S180 M3\n" +
                        $"G1 X{ChamferEndDiameter.NC()} F0.1\n" +
                        $"Z0. A-{(Angle).NC()}";
                    case Chamfer.Internal:
                        return
                        $"G0 X{(ChamferEndDiameter - 1).NC(1)} Z1. S180 M3\n" +
                        $"Z-{(ChamferSizeWithShift).NC()}\n" +
                        $"G1 X{ChamferEndDiameter.NC()} F0.1\n" +
                        $"Z0. A{(Angle).NC()}";
                    default:
                        return string.Empty;
                }
            }
            // классическая со скруглениями
            else if (ValidResult() && RoundCorners && showClassicChamfer)
            {
                return
                $"G0 X{(ChamferType == Chamfer.External ? ChamferStartDiamWithShift - 2 * (GeometryMath.ChamferRadiusLengths(Angle, CornerFullRadius).X) : ChamferStartDiamWithShift + 2 * (GeometryMath.ChamferRadiusLengths(Angle, CornerFullRadius).X)).NC()} Z1. S180 M3\n" +
                $"G1 Z0. F0.1\n" +
                $"X{ChamferStartDiamWithShift.NC()} R{(CornerFullRadius).NC()}\n" +
                $"X{ChamferEndDiameter.NC()} A{(ChamferType == Chamfer.External ? '-' : string.Empty)}{Angle.NC()} R{(CornerFullRadius).NC()}\n" +
                $"W-{(GeometryMath.ChamferRadiusLengths(Angle, CornerFullRadius).Z).NC()}";
            }
            // обратная со скруглениями
            else if (ValidResult() && RoundCorners && !showClassicChamfer)
            {
                switch (ChamferType)
                {
                    case Chamfer.External:
                        return
                        $"G0 X{(ChamferEndDiameter + 1).NC(1)} Z-{(ChamferSizeWithShift + (GeometryMath.ChamferRadiusLengths(Angle, CornerFullRadius).Z)).NC()} S180 M3\n" +
                        $"G1 X{ChamferEndDiameter.NC()}\n" +
                        $"Z-{ChamferSizeWithShift.NC()} R{(CornerFullRadius).NC()}\n" +
                        $"Z0. A-{Angle.NC()} R{(CornerFullRadius).NC()}\n" +
                        $"U-{(2 * (GeometryMath.ChamferRadiusLengths(Angle, CornerFullRadius).X)).NC()}";
                    case Chamfer.Internal:
                        return
                        $"G0 X{(ChamferEndDiameter - 1).NC(1)} Z1. S180 M3\n" +
                        $"Z-{(ChamferSizeWithShift + (GeometryMath.ChamferRadiusLengths(Angle, CornerFullRadius).Z)).NC()}\n" +
                        $"G1 X{ChamferEndDiameter.NC()}\n" +
                        $"Z-{ChamferSizeWithShift.NC()} R{(CornerFullRadius).NC()}\n" +
                        $"Z0. A{Angle.NC()} R{(CornerFullRadius).NC()}\n" +
                        $"U{(2 * (GeometryMath.ChamferRadiusLengths(Angle, CornerFullRadius).X)).NC()}";
                    default:
                        return string.Empty;
                }
            }
            return string.Empty;
        }
    }
    public enum Chamfer { External, Internal };
    public Chamfer ChamferType { get => State.ChamferType; set => State.ChamferType = value; }

    public enum Calculation { Simplified, Precise };

    public Calculation CalculationType
    {
        get => State.CalculationType;
        set
        {
            State.CalculationType = value;
            CalculateAll();
        }
    }

    public enum Images
    {
        ExternalChamfer,
        InternalChamfer,
        ExternalChamferAngle,
        ExternalChamferSize,
        ExternalStartDiameter,
        ExternalEndDiameter,
        ExternalToolRadius,
        InternalChamferAngle,
        InternalChamferSize,
        InternalStartDiameter,
        InternalEndDiameter,
        InternalToolRadius,
    };
    //public enum ImageType { Diameter, ToolRadius, ChamferAngle, ChamferSize };
    public Images CurrentImage { get => State.CurrentImage; set => State.CurrentImage = value; }

    public string _ChamferEndDiameter
    {
        get => State.ChamferEndDiameter;
        set
        {
            State.ChamferEndDiameter = value;
            CalculateAll();
        }
    }
    public double ChamferEndDiameter => Util.GetDouble(_ChamferEndDiameter);

    public string _ChamferStartDiameter
    {
        get => State.ChamferStartDiameter;
        set
        {
            State.ChamferStartDiameter = value;
            CalculateChamferSize();
        }
    }
    public double ChamferStartDiameter => Util.GetDouble(_ChamferStartDiameter);

    public string _Angle
    {
        get => State.Angle;
        set
        {
            State.Angle = value;
            if (Angle == 45) CalculationType = Calculation.Simplified;
            else CalculationType = Calculation.Precise;
            CalculateAll();
        }
    }
    public double Angle => Util.GetDouble(_Angle);

    public string _ChamferSize
    {
        get => State.ChamferSize;
        set
        {
            State.ChamferSize = value;
            CalculateStartDiam();
        }
    }
    public double ChamferSize => Util.GetDouble(_ChamferSize);

    public string _ChamferInsertRadius
    {
        get => State.ChamferInsertRadius;
        set
        {
            State.ChamferInsertRadius = value;
            CalculateAll();
        }
    }
    public double ChamferInsertRadius => Util.GetDouble(_ChamferInsertRadius);

    public double ChamferResult
    {
        get
        {
            double result;
            if (ChamferType == Chamfer.External)
            {
                result = (ChamferEndDiameter - (2 * ChamferSize * Math.Tan(GeometryMath.Radians(Angle)))) - ChamferInsertRadius * Math.Tan(GeometryMath.Radians(Angle));
            }
            else
            {
                result = ((ChamferEndDiameter + (2 * ChamferSize * Math.Tan(GeometryMath.Radians(Angle)))) + ChamferInsertRadius * Math.Tan(GeometryMath.Radians(Angle)));

            }
            return result;
        }
        set { }
    }

    public bool RoundCorners { get => State.RoundCorners; set => State.RoundCorners = value; }
    public string _RoundCorner { get => State.RoundCorner; set => State.RoundCorner = value; }
    public double RoundCorner => Util.GetDouble(_RoundCorner);

    public double XRadiusShift
    {
        get
        {
            if (CalculationType == Calculation.Precise)
            {
                return GeometryMath.ChamferShifts(Angle, ChamferInsertRadius).X;
            }
            return ChamferInsertRadius * Math.Tan(Angle.Radians()) / 2;
        }
        set { }
    }

    public double ZRadiusShift
    {
        get
        {
            if (CalculationType == Calculation.Precise)
            {
                return GeometryMath.ChamferShifts(Angle, ChamferInsertRadius).Z;
            }
            return ChamferInsertRadius * Math.Tan((90 - Angle).Radians()) / 2;
        }
        set { }
    }

    public int ExampleLines => ChamferExample.Count(f => f == '\n') + 1;

    private double ChamferStartDiamWithShift
    {
        get
        {
            if (ChamferType == Chamfer.External)
            {
                return (ChamferStartDiameter - 2 * XRadiusShift);
            }
            else
            {
                return (ChamferStartDiameter + 2 * XRadiusShift);
            }
        }
    }

    private double ChamferSizeWithShift => Math.Abs(ChamferSize + ZRadiusShift);

    public double CornerFullRadius => ChamferInsertRadius + RoundCorner;

