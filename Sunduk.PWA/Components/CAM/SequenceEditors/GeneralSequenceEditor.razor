<MudItem xs="12" md="4">
    <MudSelect Label="Переход" T="GeneralSequences" Variant="Variant.Filled" Margin="Margin.Dense" @bind-Value="GeneralSequence">
        @if (MachineType == MachineType.Turning)
        {
            <MudSelectItem Value="@(GeneralSequences.Limiter)">Упор</MudSelectItem>
            <MudSelectItem Value="@(GeneralSequences.TailStockOn)">Подвод задней бабки</MudSelectItem>
            <MudSelectItem Value="@(GeneralSequences.TailStockOff)">Отвод задней бабки</MudSelectItem>
        }
        <MudSelectItem Value="@(GeneralSequences.CustomOperation)">Произвольная операция</MudSelectItem>
        <MudSelectItem Value="@(GeneralSequences.Stop)">Остановка</MudSelectItem>
    </MudSelect>
</MudItem>
<MudItem xs="12" md="4">
    <MudSelect T="Tool" Variant="Variant.Filled" Margin="Margin.Dense" Label="Инструмент" ValueChanged="OnToolChanged">
        @foreach (var tool in Tools.Where(x => x.MachineType == MachineType))
        {
            <MudSelectItem Value="@tool">@tool.ToolCall(Machine, SelectedCoordinateSystem)</MudSelectItem>
        }
    </MudSelect>
</MudItem>
@if (Machine.CoordinateSystems.Count > 1 && GeneralSequence is GeneralSequences.Limiter or GeneralSequences.CustomOperation)
{
    <MudItem xs="12" md="4">
        <MudSelect Label="Система координат" T="CoordinateSystem" Variant="Variant.Filled" Margin="Margin.Dense" @bind-Value="SelectedCoordinateSystem">
            @foreach (var cs in Machine.CoordinateSystems)
            {
                <MudSelectItem Value="@cs" />
            }
        </MudSelect>
    </MudItem>
}
@switch (GeneralSequence)
{
    case GeneralSequences.CustomOperation:
        <MudItem xs="12" md="6">
            <MudSelect Label="Тип охлаждения" T="Coolant" Variant="Variant.Filled" Margin="Margin.Dense" @bind-Value="Coolant">
                <MudSelectItem Value="@(Coolant.General)">Обычный</MudSelectItem>
                <MudSelectItem Value="@(Coolant.Through)">Через шпиндель</MudSelectItem>
                <MudSelectItem Value="@(Coolant.Full)">Вся подача СОЖ</MudSelectItem>
                <MudSelectItem Value="@(Coolant.Blow)">Обдув</MudSelectItem>
                <MudSelectItem Value="@(Coolant.None)">Без СОЖ</MudSelectItem>
            </MudSelect>
        </MudItem>
        @if (MachineType == MachineType.Milling)
        {
            <MudItem xs="12" md="6">
                <MudSelect Label="Тип системы координат" T="bool" Variant="Variant.Filled" Margin="Margin.Dense" @bind-Value="ToolCallPolar">
                    <MudSelectItem Value="false">Декартова</MudSelectItem>
                    <MudSelectItem Value="true">Полярная</MudSelectItem>
                </MudSelect>
            </MudItem>
        }
        <MudItem xs="12">
            <MudTextField @bind-Value="CustomOperation" Label="Произвольная обработка" T="string" Variant="Variant.Filled" Margin="Margin.Dense" Immediate="true" Lines="@(CustomOperation is null ? 1 : CustomOperation.Count(x => x == '\n') + 2)" />
        </MudItem>
        break;
    case GeneralSequences.Stop:
        <MudItem xs="6">
            <MudTextField @bind-Value="CustomOperation" Label="Комментарий" T="string" Variant="Variant.Filled" Margin="Margin.Dense" Immediate="true" />
        </MudItem>
        <MudItem xs="6">
            <MudSwitch T="bool" @bind-Value="@OptionalStop" Label="Опционально" Color="Color.Primary" />
        </MudItem>
        break;
}
<MudItem Class="mt-4" xs="12" sm="12" md="12">
    <MudTextField T="string" Underline="false" Label="Предпросмотр" Style="font-family: 'Roboto Mono', monospace; font-size: medium;"
                  ReadOnly="true" Variant="Variant.Filled" Text="@("\n" + ExampleText.Trim('\n'))" Lines="@(ExampleText.Trim('\n').Count(x => x == '\n') + 3)" />
</MudItem>
<MudItem Class="d-flex flex-row-reverse py-0 px-0 mt-4">
    <MudButton Variant="Variant.Outlined" Size="Size.Large"
               EndIcon="@Icons.Material.TwoTone.PlaylistAdd" Color="Color.Primary"
               OnClick="Submit" Disabled="@(string.IsNullOrEmpty(ExampleText))">
        @(SequenceToEdit is null ? "Добавить" : "Подтвердить")
    </MudButton>
</MudItem>

@code {
    [Parameter] public Machine Machine { get; set; }
    [Parameter] public MachineType MachineType { get; set; }
    [Parameter] public CoordinateSystem CoordinateSystem { get; set; }
    [Parameter] public double SafePlane { get; set; }
    [Parameter] public double WorkpieceExternalDiameter { get; set; }
    [Parameter] public List<Tool> Tools { get; set; }
    [Parameter] public Sequence SequenceToEdit { get; set; }
    [Parameter] public EventCallback<Sequence> OnSubmit { get; set; }

    private GeneralSequences GeneralSequence { get; set; }
    private CoordinateSystem SelectedCoordinateSystem { get; set; }
    private Tool Tool { get; set; }
    private string CustomOperation { get; set; } = string.Empty;
    private Coolant Coolant { get; set; }
    private bool ToolCallPolar { get; set; }
    private bool OptionalStop { get; set; }
    private string _CuttingExternalDiameter { get; set; }
    private double CuttingExternalDiameter => _CuttingExternalDiameter.GetDouble();

    private Sequence CurrentSequence { get; set; }

    protected override void OnInitialized()
    {
        GeneralSequence = MachineType == MachineType.Turning ? GeneralSequences.Limiter : GeneralSequences.CustomOperation;
        SelectedCoordinateSystem = CoordinateSystem;
        _CuttingExternalDiameter = WorkpieceExternalDiameter.ToPrettyString();
        if (SequenceToEdit is not null) LoadFromSequence(SequenceToEdit);
    }

    private void LoadFromSequence(Sequence sequence)
    {
        switch (sequence)
        {
            case StopSequence stopSequence:
                GeneralSequence = GeneralSequences.Stop;
                CustomOperation = stopSequence.Comment;
                OptionalStop = stopSequence.Optional;
                break;
            case TurningCustomSequence turningCustom:
                GeneralSequence = GeneralSequences.CustomOperation;
                Tool = turningCustom.Tool;
                CustomOperation = turningCustom.CustomOperation;
                Coolant = turningCustom.Coolant;
                SelectedCoordinateSystem = turningCustom.CoordinateSystem;
                break;
            case MillingCustomSequence millingCustom:
                GeneralSequence = GeneralSequences.CustomOperation;
                Tool = millingCustom.Tool;
                CustomOperation = millingCustom.CustomOperation;
                Coolant = millingCustom.Coolant;
                ToolCallPolar = millingCustom.Polar;
                SelectedCoordinateSystem = millingCustom.CoordinateSystem;
                break;
            case LimiterSequence limiter:
                GeneralSequence = GeneralSequences.Limiter;
                Tool = limiter.Tool;
                _CuttingExternalDiameter = limiter.ExternalDiameter.ToPrettyString();
                SelectedCoordinateSystem = limiter.CoordinateSystem;
                break;
            case TailstockOnSequence:
                GeneralSequence = GeneralSequences.TailStockOn;
                break;
            case TailstockOffSequence:
                GeneralSequence = GeneralSequences.TailStockOff;
                break;
        }
    }

    private void OnToolChanged(Tool value)
    {
        Tool = value;
    }

    public string ExampleText
    {
        get
        {
            switch (GeneralSequence)
            {
                case GeneralSequences.Limiter:
                    CurrentSequence = GeneralSequenceFactory.CreateLimiter(machine: Machine, coordinateSystem: SelectedCoordinateSystem, tool: Tool, externalDiameter: CuttingExternalDiameter);
                    return CurrentSequence.Operation;
                case GeneralSequences.CustomOperation:
                    switch (MachineType)
                    {
                        case MachineType.Turning:
                            CurrentSequence = GeneralSequenceFactory.CreateTurningCustom(machine: Machine, coordinateSystem: SelectedCoordinateSystem, tool: Tool, customOperation: CustomOperation, coolant: Coolant);
                            return CurrentSequence.Operation;
                        case MachineType.Milling:
                            CurrentSequence = GeneralSequenceFactory.CreateMillingCustom(machine: Machine, coordinateSystem: SelectedCoordinateSystem, tool: Tool, customOperation: CustomOperation, coolant: Coolant, polar: ToolCallPolar, safePlane: SafePlane);
                            return CurrentSequence.Operation;
                    }
                    break;
                case GeneralSequences.Stop:
                    CurrentSequence = GeneralSequenceFactory.CreateStop(optional: OptionalStop, comment: CustomOperation);
                    return CurrentSequence.Operation;
                case GeneralSequences.TailStockOn:
                    CurrentSequence = GeneralSequenceFactory.CreateTailstockOn(machine: Machine);
                    return CurrentSequence.Operation;
                case GeneralSequences.TailStockOff:
                    CurrentSequence = GeneralSequenceFactory.CreateTailstockOff(machine: Machine);
                    return CurrentSequence.Operation;
            }
            return string.Empty;
        }
    }

    private async Task Submit()
    {
        if (CurrentSequence is null) return;
        await OnSubmit.InvokeAsync(CurrentSequence);
    }
}
