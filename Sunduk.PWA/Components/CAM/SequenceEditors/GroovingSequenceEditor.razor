<MudItem xs="12" md="4">
    <MudSelect Label="Переход" T="TurningGroovingSequences" Variant="Variant.Filled" Margin="Margin.Dense" @bind-Value="GroovingSequence">
        <MudSelectItem Value="@(TurningGroovingSequences.Cutting)">Отрезка</MudSelectItem>
        <MudSelectItem Value="@(TurningGroovingSequences.RoughGrooving)">Канавка черновая</MudSelectItem>
        <MudSelectItem Value="@(TurningGroovingSequences.Grooving)">Канавка</MudSelectItem>
    </MudSelect>
</MudItem>
@if (Machine.CoordinateSystems.Count > 1)
{
    <MudItem xs="12" md="4">
        <MudSelect Label="Система координат" T="CoordinateSystem" Variant="Variant.Filled" Margin="Margin.Dense" @bind-Value="SelectedCoordinateSystem">
            @foreach (var cs in Machine.CoordinateSystems)
            {
                <MudSelectItem Value="@cs" />
            }
        </MudSelect>
    </MudItem>
}
<MudItem xs="12" md="4">
    <MudSelect Label="Тип охлаждения" T="Coolant" Variant="Variant.Filled" Margin="Margin.Dense" @bind-Value="SelectedCoolant">
        <MudSelectItem Value="@(Coolant.General)">Обычный</MudSelectItem>
        <MudSelectItem Value="@(Coolant.Through)">Через шпиндель</MudSelectItem>
        <MudSelectItem Value="@(Coolant.Full)">Вся подача СОЖ</MudSelectItem>
        <MudSelectItem Value="@(Coolant.Blow)">Обдув</MudSelectItem>
        <MudSelectItem Value="@(Coolant.None)">Без СОЖ</MudSelectItem>
    </MudSelect>
</MudItem>
@switch (GroovingSequence)
{
    case TurningGroovingSequences.Grooving or TurningGroovingSequences.RoughGrooving when GrooveType is CuttingType.Radial:
        <MudItem xs="12" md="4">
            <MudSelect @bind-Value="@Tool" Variant="@Variant.Filled" Margin="Margin.Dense" Label="Инструмент" T="Tool">
                @foreach (var tool in Tools.Where(x => x is GroovingExternalTool or GroovingInternalTool))
                {
                    <MudSelectItem Value="@tool">@tool.PickerLabel</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        break;
    case TurningGroovingSequences.Cutting when GrooveType is CuttingType.Radial:
        <MudItem xs="12" md="4">
            <MudSelect Value="Tool" ValueChanged="OnToolChanged" Variant="Variant.Filled" Margin="Margin.Dense" Label="Инструмент" T="Tool">
                @foreach (var tool in Tools.Where(x => x is GroovingExternalTool))
                {
                    <MudSelectItem Value="@tool">@tool.PickerLabel</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        break;
}
@if (GrooveType is CuttingType.Face)
{
    <MudItem xs="12" md="4">
        <MudSelect Value="Tool" ValueChanged="OnToolChanged" Variant="Variant.Filled" Margin="Margin.Dense" Label="Инструмент" T="Tool">
            @foreach (var tool in Tools.Where(x => x is GroovingFaceTool))
            {
                <MudSelectItem Value="@tool">@tool.PickerLabel</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
}
@switch (GroovingSequence)
{
    case TurningGroovingSequences.Grooving or TurningGroovingSequences.RoughGrooving:
        <MudItem xs="12" md="4">
            <MudSelect Label="Тип" T="CuttingType" Value="GrooveType" Variant="Variant.Filled" Margin="Margin.Dense" ValueChanged="OnGrooveCuttingTypeChanged">
                <MudSelectItem Value="@(CuttingType.Radial)">Радиальная</MudSelectItem>
                <MudSelectItem Value="@(CuttingType.Face)">Торцевая</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField Label="Начальный диаметр" @bind-Value="_GroovingExternalDiameter" Variant="Variant.Filled" Margin="Margin.Dense" AdornmentText="мм" Immediate="true" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField Label="Конечный диаметр" @bind-Value="_GroovingInternalDiameter" Variant="Variant.Filled" Margin="Margin.Dense" AdornmentText="мм" Immediate="true" />
        </MudItem>
        @if (GrooveType is CuttingType.Face)
        {
            <MudItem xs="12" md="3">
                <MudTextField Label="Начальная точка" @bind-Value="_GroovingStartPoint" Variant="Variant.Filled" Margin="Margin.Dense" AdornmentText="мм" Immediate="true" />
            </MudItem>
        }
        else
        {
            <MudItem xs="12" md="3">
                <MudTextField Label="Ширина" @bind-Value="_GroovingWidth" Variant="Variant.Filled" Margin="Margin.Dense" AdornmentText="мм" Immediate="true" />
            </MudItem>
        }
        <MudItem xs="12" md="3">
            <MudTextField Label="От торца до канавы" @bind-Value="_GroovingCuttingPoint" Variant="Variant.Filled" Margin="Margin.Dense" AdornmentText="мм" Immediate="true" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudTextField Label="Шаг" @bind-Value="_GroovingStepOver" Variant="Variant.Filled" Margin="Margin.Dense" AdornmentText="мм" Immediate="true" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudTextField Label="Припуск" @bind-Value="_GroovingProfStockAllow" Variant="Variant.Filled" Margin="Margin.Dense" AdornmentText="мм" Immediate="true" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudTextField Label="Притупление" @bind-Value="_OuterGroovingCornerBlunt" Variant="Variant.Filled" Margin="Margin.Dense" AdornmentText="мм" Immediate="true" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect Label="Тип притупления" T="Blunt" Variant="Variant.Filled" @bind-Value="OuterGroovingBluntType" Margin="Margin.Dense">
                <MudSelectItem Value="@(Blunt.Radius)">Радиус</MudSelectItem>
                <MudSelectItem Value="@(Blunt.SimpleChamfer)">Фаска</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudTextField Label="Галтель" @bind-Value="_InnerGroovingCornerBlunt" Variant="Variant.Filled" Margin="Margin.Dense" AdornmentText="мм" Immediate="true" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect Label="Тип галтели" T="Blunt" Variant="Variant.Filled" @bind-Value="InnerGroovingBluntType" Margin="Margin.Dense">
                <MudSelectItem Value="@(Blunt.Radius)">Радиус</MudSelectItem>
                <MudSelectItem Value="@(Blunt.SimpleChamfer)">Фаска</MudSelectItem>
            </MudSelect>
        </MudItem>
        @if (GroovingSequence is TurningGroovingSequences.RoughGrooving)
        {
            <MudItem xs="6" md="6">
                <MudTextField Label="Скорость резания" @bind-Value="SpeedRough" Variant="Variant.Filled" Margin="Margin.Dense" Immediate="true" />
            </MudItem>
            <MudItem xs="6" md="6">
                <MudTextField Label="Подача" @bind-Value="_FeedRough" Variant="Variant.Filled" Margin="Margin.Dense" Immediate="true" />
            </MudItem>
        }
        else if (GroovingSequence is TurningGroovingSequences.Grooving)
        {
            <MudItem xs="6" md="3">
                <MudTextField Label="Черновая Vc" @bind-Value="SpeedRough" Variant="Variant.Filled" Margin="Margin.Dense" Immediate="true" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MudTextField Label="Черновая F" @bind-Value="_FeedRough" Variant="Variant.Filled" Margin="Margin.Dense" Immediate="true" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MudTextField Label="Чистовая Vc" @bind-Value="SpeedFinish" Variant="Variant.Filled" Margin="Margin.Dense" Immediate="true" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MudTextField Label="Чистовая F" @bind-Value="_FeedFinish" Variant="Variant.Filled" Margin="Margin.Dense" Immediate="true" />
            </MudItem>
        }
        break;
    case TurningGroovingSequences.Cutting:
        <MudItem xs="12" md="4">
            <MudTextField Label="Начальный диаметр" @bind-Value="_CuttingExternalDiameter" Variant="Variant.Filled" Margin="Margin.Dense" AdornmentText="мм" Immediate="true" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField Label="Конечный диаметр" @bind-Value="_CuttingInternalDiameter" Variant="Variant.Filled" Margin="Margin.Dense" AdornmentText="мм" Immediate="true" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField Label="Конечная точка" @bind-Value="_CuttingPoint" Variant="Variant.Filled" Margin="Margin.Dense" AdornmentText="мм" Immediate="true" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField Label="Шаг" @bind-Value="_CuttingStepOver" Variant="Variant.Filled" Margin="Margin.Dense" AdornmentText="мм" Immediate="true" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField Label="@Util.BluntLabel(CuttingBluntType)" @bind-Value="_CuttingCornerBlunt" Variant="Variant.Filled" Margin="Margin.Dense" AdornmentText="мм" Immediate="true" @onfocusin="@(() => _calcCuttingChamferDiameter = true)" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudSelect Label="Тип" T="Blunt" Variant="Variant.Filled" @bind-Value="CuttingBluntType" Margin="Margin.Dense">
                <MudSelectItem Value="@(Blunt.SimpleChamfer)">Простая фаска</MudSelectItem>
                <MudSelectItem Value="@(Blunt.Radius)">Радиус</MudSelectItem>
                <MudSelectItem Value="@(Blunt.CustomChamfer)">Настраиваемая фаска</MudSelectItem>
            </MudSelect>
        </MudItem>
        @if (CuttingBluntType == Blunt.CustomChamfer)
        {
            <MudItem xs="12" md="4">
                <MudTextField Label="Угол фаски" @bind-Value="_CuttingCustomChamferAngle" Variant="Variant.Filled" Margin="Margin.Dense" AdornmentText="°" Immediate="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField Label="Конечный диаметр фаски" @bind-Value="_CuttingCustomChamferDiameter" Variant="Variant.Filled" Margin="Margin.Dense" AdornmentText="мм" Immediate="true" @onfocusin="@(() => _calcCuttingChamferDiameter = false)" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField Label="Скругление на фаске" @bind-Value="_CuttingCustomChamferBlunt" Variant="Variant.Filled" Margin="Margin.Dense" AdornmentText="мм" Immediate="true" />
            </MudItem>
        }
        <MudItem xs="6" md="6">
            <MudTextField Label="Скорость резания" @bind-Value="SpeedRough" Variant="Variant.Filled" Margin="Margin.Dense" Immediate="true" />
        </MudItem>
        <MudItem xs="6" md="6">
            <MudTextField Label="Подача" @bind-Value="_FeedRough" Variant="Variant.Filled" Margin="Margin.Dense" Immediate="true" />
        </MudItem>
        break;
}
<MudItem Class="mt-4" xs="12" sm="12" md="12">
    <MudTextField T="string" Underline="false" Label="Предпросмотр" Style="font-family: 'JetBrains Mono', monospace; font-size: medium;"
                  ReadOnly="true" Variant="Variant.Filled" Text="@("\n" + ExampleText.Trim('\n'))" Lines="@(ExampleText.Trim('\n').Count(x => x == '\n') + 3)" />
</MudItem>
<MudItem Class="d-flex flex-row-reverse py-0 px-0 mt-4">
    <MudButton Variant="Variant.Outlined" Size="Size.Large"
               EndIcon="@Icons.Material.TwoTone.PlaylistAdd" Color="Color.Primary"
               OnClick="Submit" Disabled="@(string.IsNullOrEmpty(ExampleText))">
        @(SequenceToEdit is null ? "Добавить" : "Подтвердить")
    </MudButton>
</MudItem>

@code {
    [Parameter] public Machine Machine { get; set; }
    [Parameter] public MachineType MachineType { get; set; }
    [Parameter] public CoordinateSystem CoordinateSystem { get; set; }
    [Parameter] public Material WorkpieceMaterial { get; set; }
    [Parameter] public double WorkpieceExternalDiameter { get; set; }
    [Parameter] public List<Tool> Tools { get; set; }
    [Parameter] public Sequence SequenceToEdit { get; set; }
    [Parameter] public EventCallback<Sequence> OnSubmit { get; set; }

    private TurningGroovingSequences GroovingSequence { get; set; }
    private CoordinateSystem SelectedCoordinateSystem { get; set; }
    private Coolant SelectedCoolant { get; set; }
    private CuttingType GrooveType { get; set; }
    private Tool Tool { get; set; }

    public int SpeedRough { get; set; }
    public int SpeedFinish { get; set; }
    private string _FeedRough { get; set; } = "";
    private double FeedRough => _FeedRough.GetDouble();
    private string _FeedFinish { get; set; } = "";
    private double FeedFinish => _FeedFinish.GetDouble();

    private bool _calcCuttingChamferDiameter = true;
    private string _CuttingExternalDiameter { get; set; }
    private double CuttingExternalDiameter => _CuttingExternalDiameter.GetDouble();
    private string _CuttingInternalDiameter { get; set; }
    private double CuttingInternalDiameter => _CuttingInternalDiameter.GetDouble();
    private string _CuttingStepOver { get; set; }
    private double CuttingStepOver => _CuttingStepOver.GetDouble();
    private string _CuttingPoint { get; set; } = "-";
    private double CuttingPoint => _CuttingPoint.GetDouble(numberOption: Util.GetNumberOption.Any);

    private string _cuttingCornerBlunt;
    private string _CuttingCornerBlunt
    {
        get => _cuttingCornerBlunt;
        set
        {
            _cuttingCornerBlunt = value;
            if (_calcCuttingChamferDiameter)
            {
                _CuttingCustomChamferDiameter = (CuttingExternalDiameter - 2 * CuttingCornerBlunt * Math.Tan(CuttingCustomChamferAngle.Radians())).ToPrettyString();
            }
        }
    }
    private double CuttingCornerBlunt => _CuttingCornerBlunt.GetDouble();

    private Blunt CuttingBluntType { get; set; } = Blunt.SimpleChamfer;

    private string _cuttingCustomChamferAngle;
    private string _CuttingCustomChamferAngle
    {
        get => _cuttingCustomChamferAngle;
        set
        {
            _cuttingCustomChamferAngle = value;
            if (_calcCuttingChamferDiameter)
            {
                _CuttingCustomChamferDiameter = (CuttingExternalDiameter - 2 * CuttingCornerBlunt * Math.Tan(CuttingCustomChamferAngle.Radians())).ToPrettyString();
            }
            else
            {
                _CuttingCornerBlunt = ((CuttingExternalDiameter - CuttingCustomChamferDiameter) / 2 * Math.Tan((90 - CuttingCustomChamferAngle).Radians())).ToPrettyString();
            }
        }
    }
    private double CuttingCustomChamferAngle => _CuttingCustomChamferAngle.GetDouble();

    private string _CuttingCustomChamferBlunt { get; set; }
    private double CuttingCustomChamferBlunt => _CuttingCustomChamferBlunt.GetDouble();

    private string _cuttingCustomChamferDiameter;
    private string _CuttingCustomChamferDiameter
    {
        get => _cuttingCustomChamferDiameter;
        set
        {
            _cuttingCustomChamferDiameter = value;
            if (!_calcCuttingChamferDiameter)
            {
                _CuttingCornerBlunt = ((CuttingExternalDiameter - CuttingCustomChamferDiameter) / 2 * Math.Tan((90 - CuttingCustomChamferAngle).Radians())).ToPrettyString();
            }
        }
    }
    private double CuttingCustomChamferDiameter => _CuttingCustomChamferDiameter.GetDouble();

    private string _GroovingExternalDiameter { get; set; }
    private double GroovingExternalDiameter => _GroovingExternalDiameter.GetDouble();
    private string _GroovingInternalDiameter { get; set; }
    private double GroovingInternalDiameter => _GroovingInternalDiameter.GetDouble();
    private string _GroovingStepOver { get; set; }
    private double GroovingStepOver => _GroovingStepOver.GetDouble();
    private string _GroovingWidth { get; set; }
    private double GroovingWidth => _GroovingWidth.GetDouble();
    private string _GroovingStartPoint { get; set; }
    private double GroovingStartPoint => _GroovingStartPoint.GetDouble(numberOption: Util.GetNumberOption.Any);
    private string _GroovingCuttingPoint { get; set; } = "-";
    private double GroovingCuttingPoint => _GroovingCuttingPoint.GetDouble(numberOption: Util.GetNumberOption.Any);
    private string _GroovingProfStockAllow { get; set; }
    private double GroovingProfStockAllow => _GroovingProfStockAllow.GetDouble();
    private string _OuterGroovingCornerBlunt { get; set; }
    private double OuterGroovingCornerBlunt => _OuterGroovingCornerBlunt.GetDouble();
    private string _InnerGroovingCornerBlunt { get; set; }
    private double InnerGroovingCornerBlunt => _InnerGroovingCornerBlunt.GetDouble();
    private Blunt OuterGroovingBluntType { get; set; }
    private Blunt InnerGroovingBluntType { get; set; }

    private Sequence CurrentSequence { get; set; }

    protected override void OnInitialized()
    {
        GroovingSequence = TurningGroovingSequences.Cutting;
        GrooveType = CuttingType.Radial;
        _CuttingExternalDiameter = WorkpieceExternalDiameter.ToPrettyString();
        _CuttingInternalDiameter = "2.5";
        _CuttingCustomChamferAngle = "45";
        _GroovingExternalDiameter = WorkpieceExternalDiameter.ToPrettyString();
        _GroovingInternalDiameter = (GroovingExternalDiameter - 2).ToPrettyString();
        OuterGroovingBluntType = Blunt.Radius;
        InnerGroovingBluntType = Blunt.Radius;
        SelectedCoordinateSystem = CoordinateSystem;
        if (SequenceToEdit is not null) LoadFromSequence(SequenceToEdit);
    }

    private void LoadFromSequence(Sequence sequence)
    {
        switch (sequence)
        {
            case TurningCutOffSequence cutOff:
                GroovingSequence = TurningGroovingSequences.Cutting;
                Tool = cutOff.Tool;
                _CuttingExternalDiameter = cutOff.ExternalDiameter.ToPrettyString();
                _CuttingInternalDiameter = cutOff.InternalDiameter.ToPrettyString();
                _CuttingStepOver = cutOff.StepOver.ToPrettyString();
                _CuttingPoint = cutOff.CuttingPoint.ToPrettyString();
                CuttingBluntType = cutOff.BluntType;
                _cuttingCornerBlunt = cutOff.CornerBlunt.ToPrettyString();
                _cuttingCustomChamferAngle = cutOff.BluntCustomAngle.ToPrettyString();
                _CuttingCustomChamferBlunt = cutOff.BluntCustomRadius.ToPrettyString();
                _cuttingCustomChamferDiameter = (cutOff.ExternalDiameter - 2 * cutOff.CornerBlunt * Math.Tan(cutOff.BluntCustomAngle.Radians())).ToPrettyString();
                SpeedRough = cutOff.SpeedRough;
                _FeedRough = cutOff.FeedRough.ToPrettyString();
                SelectedCoordinateSystem = cutOff.CoordinateSystem;
                SelectedCoolant = cutOff.Coolant;
                break;
            case TurningExternalGroovingSequence extGroove:
                GroovingSequence = TurningGroovingSequences.Grooving;
                GrooveType = CuttingType.Radial;
                Tool = extGroove.Tool;
                _GroovingExternalDiameter = extGroove.ExternalDiameter.ToPrettyString();
                _GroovingInternalDiameter = extGroove.InternalDiameter.ToPrettyString();
                _GroovingWidth = extGroove.Width.ToPrettyString();
                _GroovingStepOver = extGroove.StepOver.ToPrettyString();
                _GroovingProfStockAllow = extGroove.ProfStockAllow.ToPrettyString();
                _GroovingCuttingPoint = extGroove.CuttingPoint.ToPrettyString();
                _OuterGroovingCornerBlunt = extGroove.OuterCornerBlunt.ToPrettyString();
                _InnerGroovingCornerBlunt = extGroove.InnerCornerBlunt.ToPrettyString();
                OuterGroovingBluntType = extGroove.OuterBluntType;
                InnerGroovingBluntType = extGroove.InnerBluntType;
                SpeedRough = extGroove.SpeedRough;
                SpeedFinish = extGroove.SpeedFinish;
                _FeedRough = extGroove.FeedRough.ToPrettyString();
                _FeedFinish = extGroove.FeedFinish.ToPrettyString();
                SelectedCoordinateSystem = extGroove.CoordinateSystem;
                SelectedCoolant = extGroove.Coolant;
                break;
            case TurningInternalGroovingSequence intGroove:
                GroovingSequence = TurningGroovingSequences.Grooving;
                GrooveType = CuttingType.Radial;
                Tool = intGroove.Tool;
                _GroovingExternalDiameter = intGroove.ExternalDiameter.ToPrettyString();
                _GroovingInternalDiameter = intGroove.InternalDiameter.ToPrettyString();
                _GroovingWidth = intGroove.Width.ToPrettyString();
                _GroovingStepOver = intGroove.StepOver.ToPrettyString();
                _GroovingProfStockAllow = intGroove.ProfStockAllow.ToPrettyString();
                _GroovingCuttingPoint = intGroove.CuttingPoint.ToPrettyString();
                _OuterGroovingCornerBlunt = intGroove.OuterCornerBlunt.ToPrettyString();
                _InnerGroovingCornerBlunt = intGroove.InnerCornerBlunt.ToPrettyString();
                OuterGroovingBluntType = intGroove.OuterBluntType;
                InnerGroovingBluntType = intGroove.InnerBluntType;
                SpeedRough = intGroove.SpeedRough;
                SpeedFinish = intGroove.SpeedFinish;
                _FeedRough = intGroove.FeedRough.ToPrettyString();
                _FeedFinish = intGroove.FeedFinish.ToPrettyString();
                SelectedCoordinateSystem = intGroove.CoordinateSystem;
                SelectedCoolant = intGroove.Coolant;
                break;
            case TurningFaceGroovingSequence faceGroove:
                GroovingSequence = TurningGroovingSequences.Grooving;
                GrooveType = CuttingType.Face;
                Tool = faceGroove.Tool;
                _GroovingExternalDiameter = faceGroove.ExternalDiameter.ToPrettyString();
                _GroovingInternalDiameter = faceGroove.InternalDiameter.ToPrettyString();
                _GroovingStartPoint = faceGroove.Width.ToPrettyString();
                _GroovingStepOver = faceGroove.StepOver.ToPrettyString();
                _GroovingProfStockAllow = faceGroove.ProfStockAllow.ToPrettyString();
                _GroovingCuttingPoint = faceGroove.CuttingPoint.ToPrettyString();
                _OuterGroovingCornerBlunt = faceGroove.OuterCornerBlunt.ToPrettyString();
                _InnerGroovingCornerBlunt = faceGroove.InnerCornerBlunt.ToPrettyString();
                OuterGroovingBluntType = faceGroove.OuterBluntType;
                InnerGroovingBluntType = faceGroove.InnerBluntType;
                SpeedRough = faceGroove.SpeedRough;
                SpeedFinish = faceGroove.SpeedFinish;
                _FeedRough = faceGroove.FeedRough.ToPrettyString();
                _FeedFinish = faceGroove.FeedFinish.ToPrettyString();
                SelectedCoordinateSystem = faceGroove.CoordinateSystem;
                SelectedCoolant = faceGroove.Coolant;
                break;
            case TurningExternalRoughGroovingSequence extRoughGroove:
                GroovingSequence = TurningGroovingSequences.RoughGrooving;
                GrooveType = CuttingType.Radial;
                Tool = extRoughGroove.Tool;
                _GroovingExternalDiameter = extRoughGroove.ExternalDiameter.ToPrettyString();
                _GroovingInternalDiameter = extRoughGroove.InternalDiameter.ToPrettyString();
                _GroovingWidth = extRoughGroove.Width.ToPrettyString();
                _GroovingStepOver = extRoughGroove.StepOver.ToPrettyString();
                _GroovingProfStockAllow = extRoughGroove.ProfStockAllow.ToPrettyString();
                _GroovingCuttingPoint = extRoughGroove.CuttingPoint.ToPrettyString();
                _OuterGroovingCornerBlunt = extRoughGroove.OuterCornerBlunt.ToPrettyString();
                _InnerGroovingCornerBlunt = extRoughGroove.InnerCornerBlunt.ToPrettyString();
                OuterGroovingBluntType = extRoughGroove.OuterBluntType;
                InnerGroovingBluntType = extRoughGroove.InnerBluntType;
                SpeedRough = extRoughGroove.SpeedRough;
                _FeedRough = extRoughGroove.FeedRough.ToPrettyString();
                SelectedCoordinateSystem = extRoughGroove.CoordinateSystem;
                SelectedCoolant = extRoughGroove.Coolant;
                break;
            case TurningInternalRoughGroovingSequence intRoughGroove:
                GroovingSequence = TurningGroovingSequences.RoughGrooving;
                GrooveType = CuttingType.Radial;
                Tool = intRoughGroove.Tool;
                _GroovingExternalDiameter = intRoughGroove.ExternalDiameter.ToPrettyString();
                _GroovingInternalDiameter = intRoughGroove.InternalDiameter.ToPrettyString();
                _GroovingWidth = intRoughGroove.Width.ToPrettyString();
                _GroovingStepOver = intRoughGroove.StepOver.ToPrettyString();
                _GroovingProfStockAllow = intRoughGroove.ProfStockAllow.ToPrettyString();
                _GroovingCuttingPoint = intRoughGroove.CuttingPoint.ToPrettyString();
                _OuterGroovingCornerBlunt = intRoughGroove.OuterCornerBlunt.ToPrettyString();
                _InnerGroovingCornerBlunt = intRoughGroove.InnerCornerBlunt.ToPrettyString();
                OuterGroovingBluntType = intRoughGroove.OuterBluntType;
                InnerGroovingBluntType = intRoughGroove.InnerBluntType;
                SpeedRough = intRoughGroove.SpeedRough;
                _FeedRough = intRoughGroove.FeedRough.ToPrettyString();
                SelectedCoordinateSystem = intRoughGroove.CoordinateSystem;
                SelectedCoolant = intRoughGroove.Coolant;
                break;
            case TurningFaceRoughGroovingSequence faceRoughGroove:
                GroovingSequence = TurningGroovingSequences.RoughGrooving;
                GrooveType = CuttingType.Face;
                Tool = faceRoughGroove.Tool;
                _GroovingExternalDiameter = faceRoughGroove.ExternalDiameter.ToPrettyString();
                _GroovingInternalDiameter = faceRoughGroove.InternalDiameter.ToPrettyString();
                _GroovingStartPoint = faceRoughGroove.Width.ToPrettyString();
                _GroovingStepOver = faceRoughGroove.StepOver.ToPrettyString();
                _GroovingProfStockAllow = faceRoughGroove.ProfStockAllow.ToPrettyString();
                _GroovingCuttingPoint = faceRoughGroove.CuttingPoint.ToPrettyString();
                _OuterGroovingCornerBlunt = faceRoughGroove.OuterCornerBlunt.ToPrettyString();
                _InnerGroovingCornerBlunt = faceRoughGroove.InnerCornerBlunt.ToPrettyString();
                OuterGroovingBluntType = faceRoughGroove.OuterBluntType;
                InnerGroovingBluntType = faceRoughGroove.InnerBluntType;
                SpeedRough = faceRoughGroove.SpeedRough;
                _FeedRough = faceRoughGroove.FeedRough.ToPrettyString();
                SelectedCoordinateSystem = faceRoughGroove.CoordinateSystem;
                SelectedCoolant = faceRoughGroove.Coolant;
                break;
        }
    }

    private void OnToolChanged(Tool value)
    {
        Tool = value;
    }

    private void OnGrooveCuttingTypeChanged(CuttingType value)
    {
        GrooveType = value;
        SpeedRough = Operation.GroovingSpeedRough(WorkpieceMaterial);
        SpeedFinish = Operation.GroovingSpeedFinish(WorkpieceMaterial);
        switch (GrooveType)
        {
            case CuttingType.Radial when Tool is not (GroovingExternalTool or GroovingInternalTool):
            case CuttingType.Face when Tool is not GroovingFaceTool:
                Tool = null;
                break;
        }
    }

    public string ExampleText
    {
        get
        {
            switch (GroovingSequence)
            {
                case TurningGroovingSequences.Cutting:
                    if (SpeedRough <= 0 || FeedRough <= 0) return string.Empty;
                    CurrentSequence = GroovingSequenceFactory.CreateCutOff(
                        machine: Machine,
                        coordinateSystem: SelectedCoordinateSystem,
                        material: WorkpieceMaterial,
                        tool: Tool as GroovingExternalTool,
                        cuttingPoint: CuttingPoint,
                        externalDiameter: CuttingExternalDiameter,
                        internalDiameter: CuttingInternalDiameter,
                        cornerBlunt: CuttingCornerBlunt,
                        stepOver: CuttingStepOver,
                        bluntType: CuttingBluntType,
                        bluntCustomAngle: CuttingCustomChamferAngle,
                        bluntCustomRadius: CuttingCustomChamferBlunt,
                        speedRough: SpeedRough,
                        feedRough: FeedRough,
                        coolant: SelectedCoolant);
                    return CurrentSequence.Operation;
                case TurningGroovingSequences.Grooving:
                    if (SpeedRough <= 0 || FeedRough <= 0 || (GroovingProfStockAllow > 0 && SpeedFinish <= 0 || FeedFinish <= 0)) return string.Empty;
                    switch (Tool)
                    {
                        case GroovingExternalTool groovingExternalTool:
                            CurrentSequence = GroovingSequenceFactory.CreateExternalGrooving(
                                machine: Machine, coordinateSystem: SelectedCoordinateSystem, material: WorkpieceMaterial, tool: groovingExternalTool,
                                cuttingPoint: GroovingCuttingPoint, externalDiameter: GroovingExternalDiameter, internalDiameter: GroovingInternalDiameter,
                                width: GroovingWidth, stepOver: GroovingStepOver, profStockAllow: GroovingProfStockAllow,
                                outerCornerBlunt: OuterGroovingCornerBlunt, innerCornerBlunt: InnerGroovingCornerBlunt,
                                outerBluntType: OuterGroovingBluntType, innerBluntType: InnerGroovingBluntType,
                                speedRough: SpeedRough, speedFinish: SpeedFinish, feedRough: FeedRough, feedFinish: FeedFinish, coolant: SelectedCoolant);
                            return CurrentSequence.Operation;
                        case GroovingInternalTool groovingInternalTool:
                            CurrentSequence = GroovingSequenceFactory.CreateInternalGrooving(
                                machine: Machine, coordinateSystem: SelectedCoordinateSystem, material: WorkpieceMaterial, tool: groovingInternalTool,
                                cuttingPoint: GroovingCuttingPoint, externalDiameter: GroovingExternalDiameter, internalDiameter: GroovingInternalDiameter,
                                width: GroovingWidth, stepOver: GroovingStepOver, profStockAllow: GroovingProfStockAllow,
                                outerCornerBlunt: OuterGroovingCornerBlunt, innerCornerBlunt: InnerGroovingCornerBlunt,
                                outerBluntType: OuterGroovingBluntType, innerBluntType: InnerGroovingBluntType,
                                speedRough: SpeedRough, speedFinish: SpeedFinish, feedRough: FeedRough, feedFinish: FeedFinish, coolant: SelectedCoolant);
                            return CurrentSequence.Operation;
                        case GroovingFaceTool groovingFaceTool:
                            CurrentSequence = GroovingSequenceFactory.CreateFaceGrooving(
                                machine: Machine, coordinateSystem: SelectedCoordinateSystem, material: WorkpieceMaterial, tool: groovingFaceTool,
                                cuttingPoint: GroovingCuttingPoint, externalDiameter: GroovingExternalDiameter, internalDiameter: GroovingInternalDiameter,
                                width: GroovingStartPoint, stepOver: GroovingStepOver, profStockAllow: GroovingProfStockAllow,
                                outerCornerBlunt: OuterGroovingCornerBlunt, innerCornerBlunt: InnerGroovingCornerBlunt,
                                outerBluntType: OuterGroovingBluntType, innerBluntType: InnerGroovingBluntType,
                                speedRough: SpeedRough, speedFinish: SpeedFinish, feedRough: FeedRough, feedFinish: FeedFinish, coolant: SelectedCoolant);
                            return CurrentSequence.Operation;
                    }
                    break;
                case TurningGroovingSequences.RoughGrooving:
                    if (SpeedRough <= 0 || FeedRough <= 0) return string.Empty;
                    switch (Tool)
                    {
                        case GroovingExternalTool groovingExternalTool:
                            CurrentSequence = GroovingSequenceFactory.CreateExternalRoughGrooving(
                                machine: Machine, coordinateSystem: SelectedCoordinateSystem, material: WorkpieceMaterial, tool: groovingExternalTool,
                                cuttingPoint: GroovingCuttingPoint, externalDiameter: GroovingExternalDiameter, internalDiameter: GroovingInternalDiameter,
                                width: GroovingWidth, stepOver: GroovingStepOver, profStockAllow: GroovingProfStockAllow,
                                outerCornerBlunt: OuterGroovingCornerBlunt, innerCornerBlunt: InnerGroovingCornerBlunt,
                                outerBluntType: OuterGroovingBluntType, innerBluntType: InnerGroovingBluntType,
                                speedRough: SpeedRough, feedRough: FeedRough, coolant: SelectedCoolant);
                            return CurrentSequence.Operation;
                        case GroovingInternalTool groovingInternalTool:
                            CurrentSequence = GroovingSequenceFactory.CreateInternalRoughGrooving(
                                machine: Machine, coordinateSystem: SelectedCoordinateSystem, material: WorkpieceMaterial, tool: groovingInternalTool,
                                cuttingPoint: GroovingCuttingPoint, externalDiameter: GroovingExternalDiameter, internalDiameter: GroovingInternalDiameter,
                                width: GroovingWidth, stepOver: GroovingStepOver, profStockAllow: GroovingProfStockAllow,
                                outerCornerBlunt: OuterGroovingCornerBlunt, innerCornerBlunt: InnerGroovingCornerBlunt,
                                outerBluntType: OuterGroovingBluntType, innerBluntType: InnerGroovingBluntType,
                                speedRough: SpeedRough, feedRough: FeedRough, coolant: SelectedCoolant);
                            return CurrentSequence.Operation;
                        case GroovingFaceTool groovingFaceTool:
                            CurrentSequence = GroovingSequenceFactory.CreateFaceRoughGrooving(
                                machine: Machine, coordinateSystem: SelectedCoordinateSystem, material: WorkpieceMaterial, tool: groovingFaceTool,
                                cuttingPoint: GroovingCuttingPoint, externalDiameter: GroovingExternalDiameter, internalDiameter: GroovingInternalDiameter,
                                width: GroovingStartPoint, stepOver: GroovingStepOver, profStockAllow: GroovingProfStockAllow,
                                outerCornerBlunt: OuterGroovingCornerBlunt, innerCornerBlunt: InnerGroovingCornerBlunt,
                                outerBluntType: OuterGroovingBluntType, innerBluntType: InnerGroovingBluntType,
                                speedRough: SpeedRough, feedRough: FeedRough, coolant: SelectedCoolant);
                            return CurrentSequence.Operation;
                    }
                    break;
            }
            return string.Empty;
        }
    }

    private async Task Submit()
    {
        if (CurrentSequence is null) return;
        await OnSubmit.InvokeAsync(CurrentSequence);
    }
}
