@page "/calculator"
@using NCalc
@using Sunduk.PWA.Infrastructure.Extensions
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject CalculatorPageState State
@inject AppSettings Settings
@implements IDisposable

<MudGrid Class="pa-2" Spacing="1">
    <MudItem xs="12" md="6">
        <MudField Variant="Variant.Filled" Label="Калькулятор режимов" Underline="false">
            <MudGrid>
                <MudItem xs="6">
                    <MudTextField Class="monofield" @ref="diameterField" @bind-Value="DiameterString" InputId="calculator-diameter" InputMode="KeyboardMode" T="string" Label="Диаметр" Variant="Variant.Text" Adornment="Adornment.End" AdornmentText="мм" Immediate="true" Margin="Margin.Dense" @onfocus="() => UpdateCursorPositionOnFocus(diameterField)" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @ref="edgesField" @bind-Value="EdgesString" InputId="calculator-edges" InputMode="KeyboardMode" T="string" Label="Зубья" Variant="Variant.Text" Immediate="true" Margin="Margin.Dense" @onfocus="() => UpdateCursorPositionOnFocus(edgesField)" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField Class="monofield" @ref="cutSpeedField" @bind-Value="CutSpeedString" InputId="calculator-cutSpeed" @onfocusin="@(() => CalcSpins = true)" InputMode="KeyboardMode" T="string" Label="Скорость" Variant="Variant.Text" Adornment="Adornment.End" AdornmentText="м/мин" Immediate="true" Margin="Margin.Dense" @onfocus="() => UpdateCursorPositionOnFocus(cutSpeedField)" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField Class="monofield" @ref="feedField" @bind-Value="FeedString" InputId="calculator-feed" @onfocusin="@(() => CalcMinFeed = true)" InputMode="KeyboardMode" T="string" Label="Подача" Variant="Variant.Text" Adornment="Adornment.End" AdornmentText="@FeedUnits" Immediate="true" Margin="Margin.Dense" @onfocus="() => UpdateCursorPositionOnFocus(feedField)" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField Class="monofield" @ref="spindleSpeedField" @bind-Value="SpindleSpeedString" InputId="calculator-spindleSpeed" @onfocusin="@(() => CalcSpins = false)" InputMode="KeyboardMode" T="string" Label="Обороты" Variant="Variant.Text" Adornment="Adornment.End" AdornmentText="об/мин" Immediate="true" Margin="Margin.Dense" @onfocus="() => UpdateCursorPositionOnFocus(spindleSpeedField)" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField Class="monofield" @ref="minFeedField" @bind-Value="MinFeedString" InputId="calculator-minFeed" @onfocusin="@(() => CalcMinFeed = false)" InputMode="KeyboardMode" T="string" Label="Подача" Variant="Variant.Text" Adornment="Adornment.End" AdornmentText="мм/мин" Immediate="true" Margin="Margin.Dense" @onfocus="() => UpdateCursorPositionOnFocus(minFeedField)" />
                </MudItem>
            </MudGrid>
        </MudField>
    </MudItem>
    @if (CalculatorEnabled)
    {
        <MudItem xs="12" md="6">
            <MudField Variant="Variant.Filled" Label="Калькулятор" Underline="false">
                <MudGrid Spacing="1">
                    <MudItem xs="12">
                        <MudTextField @ref="exprField" Class="monofield" InputId="calculator-expression" Margin="Margin.Dense" Variant="Variant.Text" Label="Выражение"
                                      @bind-Value="UserExpression" InputMode="KeyboardMode" @onfocus="() => UpdateCursorPositionOnFocus(exprField)"
                                      OnKeyDown="HandleKeyDown" KeyDownPreventDefault="@_preventDefault" Immediate="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField Class="monofield" Margin="Margin.Dense" Variant="Variant.Text" Label="Результат" @bind-Value="Answer" ReadOnly="true" />
                    </MudItem>

                    <MudItem xs="12">
                        <div class="calculator-keys">
                            @foreach (var key in Keys)
                            {
                                <MudButton Class="@key.CssClass" Variant="Variant.Filled" Color="@(key.Kind == KeyKind.Equals ? Color.Primary : Color.Default)"
                                           OnClick="key.OnClick" aria-label="@(key.Kind == KeyKind.Keyboard ? KeyboardAriaLabel : key.AriaLabel)">
                                    @if (key.Kind == KeyKind.Keyboard)
                                    {
                                        <MudIcon Icon="@(InputMode == InputMode.@decimal ? Icons.Material.Filled.KeyboardHide : Icons.Material.Filled.Keyboard)" />
                                    }
                                    else
                                    {
                                        @key.Label
                                    }
                                </MudButton>
                            }
                        </div>
                    </MudItem>
                    <MudItem xs="12">
                        <MudChipSet T="bool" Class="calculator-chip-set" CheckMark SelectionMode="@SelectionMode.ToggleSelection" @bind-SelectedValue="SetResultToExpression">
                            <MudChip Value="true" Text="Перенос результата в выражение" />
                        </MudChipSet>
                    </MudItem>
                </MudGrid>
            </MudField>
        </MudItem>
    }
</MudGrid>

@code
{
    protected override async Task OnInitializedAsync()
    {
        var inputModeTask = LocalStorage.GetItemAsync<InputMode?>(nameof(InputMode)).AsTask();
        var setResultTask = LocalStorage.GetItemAsync<bool>(nameof(SetResultToExpression)).AsTask();
        await Task.WhenAll(inputModeTask, setResultTask);

        // Пишем в поля, а не в свойства: иначе при загрузке значения сразу уходят обратно в LocalStorage
        _inputMode = inputModeTask.Result ?? InputMode.@decimal;
        _setResultToExpression = setResultTask.Result;

        Keys = BuildKeys();
        Settings.Changed += OnSettingsChanged;
        StateHasChanged();
    }

    private InputMode _inputMode = InputMode.@decimal;

    /// <summary> Настройка пользователя: показывать ли системную клавиатуру при фокусе на поле. </summary>
    public InputMode InputMode
    {
        get { return _inputMode; }
        set 
        { 
            _inputMode = value; 
            _ = LocalStorage.SetItemAsync(nameof(InputMode), InputMode);
        }
    }

    /// <summary> Показан ли блок «Калькулятор» (параметр приложения). </summary>
    private bool CalculatorEnabled => Settings.CalculatorEnabled;

    /// <summary>
    /// Режим клавиатуры, который реально уходит в поля. Без экранной клавиатуры калькулятора
    /// системная нужна всегда, поэтому сохранённая настройка в этом случае игнорируется (но не затирается).
    /// </summary>
    public InputMode KeyboardMode => CalculatorEnabled ? InputMode : InputMode.@decimal;

    private void OnSettingsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Settings.Changed -= OnSettingsChanged;

    private string KeyboardAriaLabel => InputMode == InputMode.@decimal ? "Скрыть системную клавиатуру" : "Показать системную клавиатуру";

    private void ToggleKeyboard() =>
        InputMode = InputMode == InputMode.@decimal ? InputMode.none : InputMode.@decimal;

    #region Экранная клавиатура

    private enum KeyKind { Function, Operator, Number, Clear, Equals, Keyboard }

    private sealed record CalcKey(string Label, KeyKind Kind, EventCallback<MouseEventArgs> OnClick, string? AriaLabel = null)
    {
        public string CssClass => Kind switch
        {
            KeyKind.Number or KeyKind.Keyboard => "calculator-key calculator-key-num",
            KeyKind.Equals => "calculator-key calculator-key-eq",
            _ => "calculator-key",
        };
    }

    private List<CalcKey> Keys { get; set; } = new();

    private EventCallback<MouseEventArgs> Cb(Func<Task> action) => EventCallback.Factory.Create<MouseEventArgs>(this, action);
    private EventCallback<MouseEventArgs> Cb(Action action) => EventCallback.Factory.Create<MouseEventArgs>(this, action);

    private CalcKey Insert(string label, string text, KeyKind kind = KeyKind.Operator, string? aria = null) =>
        new(label, kind, Cb(() => AddToExpr(text)), aria);

    private CalcKey Trig(string label, TrigonometricFunction function) =>
        new(label, KeyKind.Function, Cb(() => CalculateTrigonometricFunction(function)));

    private List<CalcKey> BuildKeys() => new()
    {
        Trig("Sin", TrigonometricFunction.Sin), Insert("X²", "²", KeyKind.Function), Insert("÷", "/", aria: "Разделить"), Insert("×", "*", aria: "Умножить"),
        new("C", KeyKind.Clear, Cb(ClearCalculator), "Очистить"), new("⌫", KeyKind.Clear, Cb(EraseLeftExpr), "Удалить символ"),

        Trig("Cos", TrigonometricFunction.Cos), Insert("√X", "Sqrt(", KeyKind.Function, "Квадратный корень"), Insert("7", "7", KeyKind.Number), Insert("8", "8", KeyKind.Number),
        Insert("9", "9", KeyKind.Number), Insert("−", "-", aria: "Минус"),

        Trig("Tan", TrigonometricFunction.Tan), Insert("Xⁿ", "^", KeyKind.Function, "Степень"), Insert("4", "4", KeyKind.Number), Insert("5", "5", KeyKind.Number),
        Insert("6", "6", KeyKind.Number), Insert("+", "+", aria: "Плюс"),

        Trig("Atan", TrigonometricFunction.Atan), Insert("𝜋", "𝜋", KeyKind.Function, "Число пи"), Insert("1", "1", KeyKind.Number), Insert("2", "2", KeyKind.Number),
        Insert("3", "3", KeyKind.Number), Insert("%", "%"),

        Insert("(", "("), Insert(")", ")"), new("", KeyKind.Keyboard, Cb(ToggleKeyboard)), Insert("0", "0", KeyKind.Number), Insert(".", ".", KeyKind.Number, "Десятичная точка"),
        new("=", KeyKind.Equals, Cb(Calculate), "Вычислить"),
    };

    #endregion

    private bool _setResultToExpression;

    public bool SetResultToExpression
    {
        get { return _setResultToExpression; }
        set 
        { 
            _setResultToExpression = value; 
            _ = LocalStorage.SetItemAsync(nameof(SetResultToExpression), SetResultToExpression);
        }
    }

    public bool CalcSpins { get => State.CalcSpins; set => State.CalcSpins = value; }
    public bool CalcMinFeed { get => State.CalcMinFeed; set => State.CalcMinFeed = value; }



    private const string RadianToDegreeFunction = "Deg";
    private const string DegreeToRadianFunction = "Rad";

    // Ссылки на поля ввода
    private MudTextField<string>? diameterField;
    private MudTextField<string>? edgesField;
    private MudTextField<string>? cutSpeedField;
    private MudTextField<string>? feedField;
    private MudTextField<string>? spindleSpeedField;
    private MudTextField<string>? minFeedField;
    private MudTextField<string>? exprField;
    private MudTextField<string>? activeField;

    private bool _preventDefault;

    enum TrigonometricFunction
    {
        Sin,
        Cos,
        Tan,
        Atan
    }

    #region Диаметр

    public string DiameterString
    {
        get => State.DiameterString;
        set
        {
            State.DiameterString = value;
            if (Diameter > 0)
            {
                if (CalcSpins)
                {
                    SpindleSpeedString = Util.ToPrettyString((CutSpeed * 1000) / (Diameter * Math.PI), 0);
                }
                else if (!CalcSpins)
                {
                    CutSpeedString = Util.ToPrettyString((Diameter * Math.PI * SpindleSpeed) / 1000);
                }
            }
        }
    }

    public double Diameter => Util.GetDouble(DiameterString, 0);

    #endregion

    #region Скрость резания
    public string CutSpeedString
    {
        get => State.CutSpeedString;
        set
        {
            State.CutSpeedString = value;
            if (CalcSpins)
            {
                SpindleSpeedString = Util.ToPrettyString((CutSpeed * 1000) / (Diameter * Math.PI), 0);
            }
            if (CalcMinFeed)
            {
                MinFeedString = Util.ToPrettyString(Feed * SpindleSpeed * Edges, 0);
            }
            else if (!CalcMinFeed)
            {
                FeedString = Util.ToPrettyString(MinFeed / (SpindleSpeed * Edges), 3);
            }
        }
    }

    public double CutSpeed => Util.GetDouble(CutSpeedString, 0);

    #endregion

    #region Обороты
    public string SpindleSpeedString
    {
        get => State.SpindleSpeedString;
        set
        {
            State.SpindleSpeedString = value;
            if (Diameter > 0)
            {
                if (!CalcSpins)
                {
                    CutSpeedString = Util.ToPrettyString((Diameter * Math.PI * SpindleSpeed) / 1000, 0);
                }
                if (CalcMinFeed)
                {
                    MinFeedString = Util.ToPrettyString(Feed * SpindleSpeed * Edges, 0);
                }
                else if (!CalcMinFeed)
                {
                    FeedString = Util.ToPrettyString(MinFeed / (SpindleSpeed * Edges), 3);
                }
            }
        }
    }

    public double SpindleSpeed => Util.GetDouble(SpindleSpeedString, 0);

    #endregion

    #region Зубья
    public string EdgesString
    {
        get => State.EdgesString;
        set
        {
            State.EdgesString = value;
            if (CalcMinFeed)
            {
                MinFeedString = Util.ToPrettyString(Feed * SpindleSpeed * Edges, 0);
            }
            else if (!CalcMinFeed)
            {
                FeedString = Util.ToPrettyString(MinFeed / (SpindleSpeed * Edges), 3);
            }
        }
    }

    public int Edges => Util.GetInt(EdgesString, 1);

    #endregion

    public string FeedUnits => Edges > 1 ? "мм/зуб" : "мм/об";

    #region Подача
    public string FeedString
    {
        get => State.FeedString;
        set
        {
            State.FeedString = value;
            if (CalcMinFeed)
            {
                MinFeedString = Util.ToPrettyString(Feed * SpindleSpeed * Edges, 0);
            }
        }
    }
    public double Feed => Util.GetDouble(FeedString);

    #endregion

    #region Минутная подача
    public string MinFeedString
    {
        get => State.MinFeedString;
        set
        {
            State.MinFeedString = value;
            if (!CalcMinFeed)
            {
                FeedString = Util.ToPrettyString(MinFeed / (SpindleSpeed * Edges), 3);
            }
        }
    }

    public double MinFeed => Util.GetDouble(MinFeedString);

    #endregion

    public string CalcInfo
    {
        get
        {
            string text = string.Empty;
            if (CalcSpins && Diameter > 0 && CutSpeed > 0)
            {
                text += $"Обороты: ({CutSpeed.ToPrettyString()}*1000)/(π*{Diameter}) = {Util.ToPrettyString((CutSpeed * 1000) / (Diameter * Math.PI), 0)} об/мин";
            }
            if (!CalcSpins && Diameter > 0 && SpindleSpeed > 0)
            {
                text += $"Скорость: π*{Diameter}*{SpindleSpeed}/1000 = {Util.ToPrettyString((Diameter * Math.PI * SpindleSpeed) / 1000, 0)} м/мин";
            }
            if (CalcMinFeed && Diameter > 0 && SpindleSpeed > 0 && Feed > 0)
            {
                text += Edges == 1
                    ? $"\nПодачу: {Feed.ToPrettyString()}*{SpindleSpeed} = {Util.ToPrettyString(Feed * SpindleSpeed * Edges, 0)} мм/мин"
                    : $"\nПодачу: {Feed.ToPrettyString()}*{SpindleSpeed}*{Edges} = {Util.ToPrettyString(Feed * SpindleSpeed * Edges, 0)} мм/мин";
            }
            if (!CalcMinFeed && Diameter > 0 && SpindleSpeed > 0 && MinFeed > 0)
            {
                text += Edges == 1
                    ? $"\nПодачу: {MinFeed}/{SpindleSpeed} = {Util.ToPrettyString(MinFeed / (SpindleSpeed * Edges), 3)} {FeedUnits}"
                    : $"\nПодачу: {MinFeed}/{SpindleSpeed}*{Edges} = {Util.ToPrettyString(MinFeed / (SpindleSpeed * Edges), 3)} {FeedUnits}";
            }
            return text;
        }
        set { }
    }

    public string Answer { get => State.Answer; set => State.Answer = value; }
    public string UserExpression { get => State.UserExpression; set => State.UserExpression = value; }

    async Task AddToExpr(string text)
    {
        // Пока пользователь не фокусировался ни на одном поле, кнопки пишут в выражение
        activeField ??= exprField;
        if (activeField == null) return;

        try
        {
            var inputRef = activeField.InputReference;
            if (inputRef == null) return;

            // Получаем текущее значение
            var currentValue = activeField.Value ?? string.Empty;

            // Используем JS interop для получения позиции курсора
            var selectionStart = await JSRuntime.InvokeAsync<int>("eval",
                $"document.getElementById('{GetInputId(activeField)}').selectionStart");
            var selectionEnd = await JSRuntime.InvokeAsync<int>("eval",
                $"document.getElementById('{GetInputId(activeField)}').selectionEnd");

            // Вставляем текст в позицию курсора
            var newValue = currentValue.Substring(0, selectionStart) + text + currentValue.Substring(selectionEnd);

            // Обновляем значение соответствующего поля
            UpdateFieldValue(activeField, newValue);

            StateHasChanged();

            // Устанавливаем курсор после вставленного текста
            await Task.Delay(10);
            var newCursorPos = selectionStart + text.Length;
            await inputRef.SelectRangeAsync(newCursorPos, newCursorPos);
        }
        catch (Exception ex)
        {
            // Fallback - добавляем в конец
            Console.WriteLine($"Ошибка при вставке: {ex.Message}");
            FallbackAddToExpr(text);
        }
    }

    async Task EraseLeftExpr()
    {
        activeField ??= exprField;
        if (activeField == null) return;

        try
        {
            var inputRef = activeField.InputReference;
            if (inputRef == null) return;

            var currentValue = activeField.Value ?? string.Empty;

            if (currentValue.Length == 0) return;

            var selectionStart = await JSRuntime.InvokeAsync<int>("eval",
                $"document.getElementById('{GetInputId(activeField)}').selectionStart");
            var selectionEnd = await JSRuntime.InvokeAsync<int>("eval",
                $"document.getElementById('{GetInputId(activeField)}').selectionEnd");

            string newValue;
            int newCursorPos;

            if (selectionStart != selectionEnd)
            {
                newValue = currentValue.Substring(0, selectionStart) + currentValue.Substring(selectionEnd);
                newCursorPos = selectionStart;
            }
            else if (selectionStart > 0)
            {
                newValue = currentValue.Substring(0, selectionStart - 1) + currentValue.Substring(selectionStart);
                newCursorPos = selectionStart - 1;
            }
            else
            {
                return;
            }

            UpdateFieldValue(activeField, newValue);

            StateHasChanged();

            await Task.Delay(10);
            await inputRef.SelectRangeAsync(newCursorPos, newCursorPos);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при удалении: {ex.Message}");
            FallbackEraseLeftExpr();
        }
    }

    void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _preventDefault = true;
            Calculate();
        }
        else
        {
            _preventDefault = false;
        }
    }

    void ClearCalculator()
    {
        if (activeField != null && activeField != exprField)
        {
            UpdateFieldValue(activeField, string.Empty);
        }
        else
        {
            UserExpression = string.Empty;
            Answer = string.Empty;
        }
    }

    private string GetInputId(MudTextField<string> field)
    {
        if (field == diameterField) return "calculator-diameter";
        if (field == edgesField) return "calculator-edges";
        if (field == cutSpeedField) return "calculator-cutSpeed";
        if (field == feedField) return "calculator-feed";
        if (field == spindleSpeedField) return "calculator-spindleSpeed";
        if (field == minFeedField) return "calculator-minFeed";
        if (field == exprField) return "calculator-expression";
        return "calculator-field";
    }

    private void UpdateFieldValue(MudTextField<string> field, string value)
    {
        if (field == diameterField) DiameterString = value;
        else if (field == edgesField) EdgesString = value;
        else if (field == cutSpeedField) CutSpeedString = value;
        else if (field == feedField) FeedString = value;
        else if (field == spindleSpeedField) SpindleSpeedString = value;
        else if (field == minFeedField) MinFeedString = value;
        else if (field == exprField) UserExpression = value;
    }

    private void FallbackAddToExpr(string text)
    {
        if (activeField == exprField)
        {
            UserExpression += text;
        }
        else if (activeField != null)
        {
            var currentValue = activeField.Value ?? string.Empty;
            UpdateFieldValue(activeField, currentValue + text);
        }
    }

    private void FallbackEraseLeftExpr()
    {
        if (activeField == exprField && UserExpression.Length > 0)
        {
            UserExpression = UserExpression[..^1];
        }
        else if (activeField != null)
        {
            var currentValue = activeField.Value ?? string.Empty;
            if (currentValue.Length > 0)
            {
                UpdateFieldValue(activeField, currentValue[..^1]);
            }
        }
    }

    private void UpdateCursorPositionOnFocus(MudTextField<string>? field)
    {
        activeField = field;
    }


    void CalculateTrigonometricFunction(TrigonometricFunction function)
    {
        if (!double.TryParse(UserExpression
            .TrimStart("Sin(")
            .TrimStart("Cos(")
            .TrimStart("Tan(")
            .TrimStart("Atan(")
            .TrimEnd(')')
            .Replace(".", ","), out var userExpr))
        {
            UserExpression = "";
            Answer = "";
            return;
        }
        switch (function)
        {
            case TrigonometricFunction.Sin:
                UserExpression = $"Sin({userExpr})".Replace(',', '.');
                Answer = Math.Sin(userExpr.Radians()).ToPrettyString(stringOption: Util.PrettyStringOption.AsIs);
                break;
            case TrigonometricFunction.Cos:
                UserExpression = $"Cos({userExpr})".Replace(',', '.');
                Answer = Math.Cos(userExpr.Radians()).ToPrettyString(stringOption: Util.PrettyStringOption.AsIs);
                break;
            case TrigonometricFunction.Tan:
                UserExpression = $"Tan({userExpr})".Replace(',', '.');
                Answer = Math.Tan(userExpr.Radians()).ToPrettyString(stringOption: Util.PrettyStringOption.AsIs);
                break;
            case TrigonometricFunction.Atan:
                UserExpression = $"Atan({userExpr})".Replace(',', '.');
                Answer = Math.Atan(userExpr).Degrees().ToPrettyString(stringOption: Util.PrettyStringOption.AsIs);
                break;
            default:
                break;
        }
    }

    void Calculate()
    {
        List<string> calcErrors = new();
        try
        {
            var userExpr = UserExpression.Trim().Replace("𝜋", Math.PI.ToString()).Replace("²", "**2").Replace("^", "**").Replace(',', '.');
            var expr = new Expression(userExpr, ExpressionOptions.IgnoreCaseAtBuiltInFunctions | ExpressionOptions.CaseInsensitiveStringComparer);
            expr.Functions[DegreeToRadianFunction] = (args) =>
                {
                    if (args.Count() > 1) Util.ThrowLogged<ArgumentOutOfRangeException>($"Слишком много аргументов для функции {DegreeToRadianFunction}", calcErrors);
                    double d = args.Evaluate(0) switch
                    {
                        double dd => dd,
                        int ii => ii,
                        long ll => ll,
                        string ss => Util.ToDouble(ss.Replace(',', '.')),
                        _ => throw new ArgumentException($"Неподдерживаемый тип: {args?.GetType()}")
                    };
                    return d * Math.PI / 180;
                };

            expr.Functions[RadianToDegreeFunction] = (args) =>
            {
                if (args.Count() > 1) Util.ThrowLogged<ArgumentOutOfRangeException>($"Слишком много аргументов для функции {RadianToDegreeFunction}", calcErrors);
                double d = args.Evaluate(0) switch
                {
                    double dd => dd,
                    int ii => ii,
                    long ll => ll,
                    string ss => Util.ToDouble(ss.Replace(',', '.')),
                    _ => Util.ThrowLogged<ArgumentException>($"Неподдерживаемый тип: {args?.GetType()}", calcErrors),
                };
                return d * 180 / Math.PI;
            };
            if (expr.HasErrors())
            {
                Snackbar.Add(expr.Error.Message);
                return;
            }
            var r = expr.Evaluate();
            if (r is null)
            {
                Snackbar.Add("Не удалось вычислить");
                return;
            }
            var result = r is double d ? d.ToPrettyString(stringOption: Util.PrettyStringOption.AsIs) :
                         r is int i ? i.ToString() :
                         r is long l ? l.ToString() :
                         r?.ToString() ?? "[?]";
            if (SetResultToExpression)
            {
                UserExpression = result;
            }
            Answer = result;
            activeField = exprField;
            StateHasChanged();
            _ = SetCursorToEnd();
            return;
        }
        catch
        {
            Snackbar.Add($"Ошибки при вычислении: {string.Join(", ", calcErrors)}");
        }
    }

    private async Task SetCursorToEnd()
    {
        if (exprField?.InputReference != null)
        {
            await Task.Delay(50);

            try
            {
                await exprField.InputReference.FocusAsync();
                var length = UserExpression?.Length ?? 0;
                await exprField.InputReference.SelectRangeAsync(length, length);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Ошибка при установке курсора: {ex.Message}");
            }
        }
    }
}