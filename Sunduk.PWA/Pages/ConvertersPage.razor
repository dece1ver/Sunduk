@page "/converters"
@using MudBlazor.Extensions

<MudSwipeArea OnSwipe="@OnSwipe">
    <MudTabs Elevation="2" @ref="tabs" Style="font-size: small">
        <MudTabPanel Text="Углы">
            <AngleConverterComponent />
        </MudTabPanel>
        <MudTabPanel Text="Координаты точки">
            <PointCoordinatesComponent />
        </MudTabPanel>
    </MudTabs>
</MudSwipeArea>

@code
{
    MudTabs tabs;

    public void OnSwipe(SwipeDirection direction)
    {
        if (direction == SwipeDirection.LeftToRight)
        {
            if (tabs.GetState(x => tabs.ActivePanelIndex) > 0)
            {
                tabs.ActivatePanelAsync(tabs.GetState(x => tabs.ActivePanelIndex) - 1);
            }
        }
        else if (direction == SwipeDirection.RightToLeft)
        {
            if (tabs.GetState(x => tabs.ActivePanelIndex) < 1)
            {
                tabs.ActivatePanelAsync(tabs.GetState(x => tabs.ActivePanelIndex) + 1);
            }
        }
    }
}
