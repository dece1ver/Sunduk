@page "/stuff"
@using MudBlazor.Extensions

<MudSwipeArea OnSwipeEnd="OnSwipe">
    <MudTabs Elevation="2" @ref="tabs" Style="font-size: small">
        <MudTabPanel Text="Резьба">
            <ThreadTurningComponent />
        </MudTabPanel>
        <MudTabPanel Text="Фаска">
            <ChamferComponent />
        </MudTabPanel>
        <MudTabPanel Text="Дуги">
            <ArcsComponent />
        </MudTabPanel>
        <MudTabPanel Text="Конус сверла">
            <DrillAngleComponent />
        </MudTabPanel>
        <MudTabPanel Text="Расточка">
            <HoleCapacityComponent />
        </MudTabPanel>

    </MudTabs>
</MudSwipeArea>

@code 
{
    MudTabs tabs = default!;

    public void OnSwipe(SwipeEventArgs args)
    {
        if (args.SwipeDirection == SwipeDirection.LeftToRight)
        {
            if (tabs.GetState(x => x.ActivePanelIndex) > 0)
            {
                tabs.ActivatePanelAsync(tabs.GetState(x => x.ActivePanelIndex) - 1);
            }
        }
        else if (args.SwipeDirection == SwipeDirection.RightToLeft)
        {
            if (tabs.GetState(x => x.ActivePanelIndex) < 4)
            {
                tabs.ActivatePanelAsync(tabs.GetState(x => x.ActivePanelIndex) + 1);
            }
        }
    }
}
