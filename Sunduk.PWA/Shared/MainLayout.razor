@inject IDialogService DialogService
@inject AppSettings Settings
@inject OfflineStatusMonitor OfflineMonitor
@inject NavigationManager Navigation
@inject NavUsage NavUsage
@implements IDisposable
@inherits LayoutComponentBase
@using MudBlazor.Services

<BlazorCommon.RazorLib.BlazorCommonInitializer />
<BlazorTextEditor.RazorLib.BlazorTextEditorInitializer />

<MudThemeProvider Theme="CurrentTheme" @bind-IsDarkMode="IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudScrollToTop>
    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" />
</MudScrollToTop>

<MudLayout>
    <MudAppBar Dense="true" Elevation="0">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudLink Typo="Typo.h6" Href="" Underline="Underline.None" Style="font-family: 'Saira Stencil One';">SUNDUK</MudLink>
        <MudSpacer />
        @if (DebugMode)
        {
            <MudText Typo="Typo.caption">@Breakpoint</MudText>
        }
        <MudTooltip Text="Параметры" Placement="Placement.Start">
            <MudIconButton Icon="@Icons.Material.Filled.Settings" @onclick="OpenSettingsDialogAsync" Color="Color.Inherit" />
        </MudTooltip>
        <MudTooltip Text="Обратная связь" Placement="Placement.Start">
            <MudIconButton Icon="@Icons.Material.Filled.Feedback" @onclick="OpenFeedBackDialogAsync" Color="Color.Inherit" Edge="Edge.End" />
        </MudTooltip>
        <MudTooltip Text="QR-код и установка" Placement="Placement.Start">
            <MudIconButton Icon="@Icons.Material.Filled.QrCodeScanner" @onclick="OpenQrDialogAsync" Color="Color.Inherit" Edge="Edge.End" />
        </MudTooltip>
        <MudTooltip Text="@version" Placement="Placement.Start">
            <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" @onclick="OpenChangelogDialogAsync" Color="Color.Inherit" Edge="Edge.End" />
        </MudTooltip>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Breakpoint="Breakpoint.Md" ClipMode="DrawerClipMode.Always" Elevation="0">
        <CascadingValue Value="ExperimentalMode" Name="ExperimantalMode">
            <NavMenu />
        </CascadingValue>
    </MudDrawer>
    <MudMainContent Class="main-content-with-bottom-nav">
        @* Ключ меняется вместе с форматом чисел: страница создаётся заново и показывает результаты в новом формате *@
        <CascadingValue Value="ExperimentalMode" Name="ExperimantalMode" @key="Settings.FormatVersion">
            @Body
        </CascadingValue>
    </MudMainContent>
    @* Нижняя панель для телефонов: частые разделы под большим пальцем. На широких экранах скрыта (там боковое меню). *@
    <nav class="bottom-nav" aria-label="Основные разделы">
        @foreach (var section in _bottomSections)
        {
            <NavLink class="bottom-nav-item" href="@section.Href" Match="NavLinkMatch.Prefix">
                <MudIcon Icon="@section.Icon" /><span>@section.Title</span>
            </NavLink>
        }
        <button type="button" class="bottom-nav-item" @onclick="DrawerToggle">
            <MudIcon Icon="@Icons.Material.Filled.Apps" /><span>Ещё</span>
        </button>
    </nav>
</MudLayout>

@code
{
    public static bool DebugMode { get; set; } = false;
    public bool ExperimentalMode { get; set; } = DebugMode;

    public bool IsDark
    {
        get => Settings.IsDark;
        set => _ = Settings.SetDarkAsync(value);
    }

    public MudTheme CurrentTheme => AppTheme.GetTheme(IsDark, isAmber: false);

    // Набор разделов в нижней панели считается один раз при запуске: порядок не должен
    // перескакивать на глазах, иначе пропадает мышечная память.
    private IReadOnlyList<NavSection> _bottomSections = NavUsage.Sections.Take(NavUsage.Slots).ToList();

    protected override void OnInitialized()
    {
        UpdateFormatContext(Navigation.ToBaseRelativePath(Navigation.Uri));
        Navigation.LocationChanged += OnLocationChanged;
        Settings.Changed += OnSettingsChanged;
    }

    /// <summary> В SunduCAM числа форматируются по его собственным параметрам, везде остальное — по общим. </summary>
    private static void UpdateFormatContext(string relativePath) =>
        ResultFormats.IsCam = relativePath.StartsWith("sunducam", StringComparison.OrdinalIgnoreCase);

    private void UpdateBottomSections() => _bottomSections = Settings.NavOrder == NavOrderMode.ByUsage
        ? NavUsage.Top()
        : NavUsage.Sections.Take(NavUsage.Slots).ToList();

    private void OnSettingsChanged()
    {
        UpdateBottomSections();
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var relativePath = Navigation.ToBaseRelativePath(e.Location);
        UpdateFormatContext(relativePath);
        _ = NavUsage.RecordAsync(relativePath);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Settings.Changed -= OnSettingsChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Settings.LoadAsync();
            await NavUsage.LoadAsync();
            UpdateBottomSections();
            await NavUsage.RecordAsync(Navigation.ToBaseRelativePath(Navigation.Uri));

            // Состояние офлайн-режима. Показывается строкой статуса в диалоге
            // «Описание», но следить за service worker нужно с первого рендера,
            // иначе в диалоге не будет актуальных данных.
            await OfflineMonitor.StartAsync();

            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    public Breakpoint Breakpoint { get; set; }

    string version = System.Reflection.Assembly.GetExecutingAssembly().GetName().Version?.ToString() ?? "?";

    bool _drawerOpen = true;

    private Task OpenSettingsDialogAsync()
    {
        var options = new DialogOptions() {
            FullScreen = false,
            CloseButton = true,
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };
        return DialogService.ShowAsync<SettingsDialog>("Параметры", options);
    }

    private Task OpenQrDialogAsync()
    {
        var options = new DialogOptions() {
            FullScreen = false,
            CloseButton = true,
            CloseOnEscapeKey = true
        };
        return DialogService.ShowAsync<QrDialog>(string.Empty, options);
    }

    private Task OpenFeedBackDialogAsync()
    {
        var options = new DialogOptions() {
            FullScreen = false,
            CloseButton = true,
            CloseOnEscapeKey = true,
        };
        return DialogService.ShowAsync<FeedBackDialog>("Обратная связь", options);
    }

    private Task OpenChangelogDialogAsync()
    {
        var options = new DialogOptions() {
            FullScreen = false,
            CloseButton = true,
            CloseOnEscapeKey = true
        };
        return DialogService.ShowAsync<ChangelogDialog>("Описание", options);
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}
